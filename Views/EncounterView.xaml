<UserControl x:Class="EpicBattle.Views.EncounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#100E14" Foreground="White">
    <Grid>
        <!-- Фоновая иллюстрация случайного события -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.88"/>
        <Border Background="#35100E14"/>

        <Grid Margin="20" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка события -->
            <Border Grid.Row="0" Background="#DD1E1C24" BorderBrush="#554466" BorderThickness="1.5" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Name="IconText" Text="📜" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Name="TitleText" Text="Случайное событие" FontSize="20" FontWeight="Bold" Foreground="#FFAA00" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="❤️ HP: " Foreground="#FF5555" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Name="HpText" Text="100/100" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text=" | 💰 " Foreground="#FFDD44" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                        <TextBlock Name="GoldText" Text="50" Foreground="#FFDD44" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Центральный контент: Баннер, описание и выборы -->
            <Border Grid.Row="1" Background="#E016141D" BorderBrush="#443750" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Баннер события с градиентным переходом к контенту -->
                    <Grid Grid.Row="0">
                        <Image Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10000000" Offset="0.0"/>
                                    <GradientStop Color="#5016141D" Offset="0.5"/>
                                    <GradientStop Color="#E016141D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,10,20,15">
                        <StackPanel>
                            <TextBlock Name="DescriptionText" Text="Описание события..." FontSize="17" Foreground="#EEEEEE" TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,15"/>

                            <Separator Background="#3A3245" Margin="0,0,0,15"/>

                            <!-- Панель исхода события (результат выбора) -->
                            <Border Name="ResultPanel" Background="#D0202820" BorderBrush="#55AA55" BorderThickness="1.5" CornerRadius="6" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Name="ResultText" Text="Результат..." FontSize="15" FontWeight="Bold" Foreground="#88FF88" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Список вариантов выбора -->
                            <ItemsControl Name="ChoicesControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,5" Padding="16,12" Background="#CC262230" BorderBrush="#604D70" BorderThickness="1.5"
                                                HorizontalContentAlignment="Left" Click="ChoiceBtn_Click" Tag="{Binding}" Cursor="Hand">
                                            <TextBlock Text="{Binding Text}" FontSize="15" Foreground="White" TextWrapping="Wrap" FontWeight="Medium"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Нижняя кнопка продолжения пути -->
            <Button Name="ContinueBtn" Grid.Row="2" Content="➡️ Продолжить путь" Height="44" FontSize="16" FontWeight="Bold" Background="#2E6B30" Click="ContinueBtn_Click" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
