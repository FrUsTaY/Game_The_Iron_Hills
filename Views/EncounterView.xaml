<UserControl x:Class="EpicBattle.Views.EncounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181818" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка события -->
        <Border Grid.Row="0" Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Name="IconText" Text="📜" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Name="TitleText" Text="Случайное событие" FontSize="20" FontWeight="Bold" Foreground="#FFAA00" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="❤️ HP: " Foreground="#FF5555" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Name="HpText" Text="100/100" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text=" | 💰 " Foreground="#FFDD44" FontSize="14" FontWeight="Bold" Margin="8,0,0,0"/>
                    <TextBlock Name="GoldText" Text="50" Foreground="#FFDD44" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Центральный контент: Описание и выборы -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Name="DescriptionText" Text="Описание события..." FontSize="16" Foreground="LightGray" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,20"/>

                    <Separator Background="#333333" Margin="0,0,0,15"/>

                    <!-- Панель исхода события (результат выбора) -->
                    <Border Name="ResultPanel" Background="#282828" BorderBrush="#555555" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                        <TextBlock Name="ResultText" Text="Результат..." FontSize="15" FontWeight="Bold" Foreground="#55FF55" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Список вариантов выбора -->
                    <ItemsControl Name="ChoicesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,5" Padding="12,10" Background="#282828" BorderBrush="#444444" BorderThickness="1"
                                        HorizontalContentAlignment="Left" Click="ChoiceBtn_Click" Tag="{Binding}">
                                    <TextBlock Text="{Binding Text}" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Нижняя кнопка продолжения пути -->
        <Button Name="ContinueBtn" Grid.Row="2" Content="➡️ Продолжить путь" Height="45" FontSize="16" FontWeight="Bold" Background="#3a3a3a" Click="ContinueBtn_Click" Visibility="Collapsed"/>
    </Grid>
</UserControl>
