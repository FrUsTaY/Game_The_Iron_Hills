<UserControl x:Class="EpicBattle.Views.DialogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111" KeyDown="UserControl_KeyDown" Focusable="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid>
            <!-- Background Image Placeholder (Could be added later) -->
            <Image Name="BgImage" Stretch="UniformToFill" Opacity="0.3"/>

            <Grid Margin="40">
            <Grid.RowDefinitions>
                <!-- Верхняя панель: Подсказки/Кнопки -->
                <RowDefinition Height="Auto"/>
                <!-- Основное пространство -->
                <RowDefinition Height="*"/>
                <!-- Кнопки выбора -->
                <RowDefinition Height="Auto"/>
                <!-- Блок текста -->
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- Кнопка меню паузы/сохранения -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Right">
                <TextBlock Text="ESC - Меню паузы" Foreground="Gray" FontSize="14"/>
            </StackPanel>

            <!-- Choices Panel -->
            <ItemsControl Name="ChoicesControl" Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}" Margin="0,5" Padding="20,10" Background="#333333" Foreground="White" BorderBrush="#555555" Click="ChoiceBtn_Click" MaxWidth="700">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" TextAlignment="Left"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Text Box -->
            <Border Grid.Row="3" Background="#AA000000" BorderBrush="#444444" BorderThickness="2" CornerRadius="5" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Name="SpeakerText" Grid.Row="0" Text="Имя" Foreground="#FFAA00" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="DialogueText" Text="Текст диалога..." Foreground="White" FontSize="18" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

            <!-- Pause Menu Overlay -->
            <Border Name="PauseOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <TextBlock Text="ПАУЗА" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button Content="Продолжить" Margin="0,10" Height="40" FontSize="18" Click="ResumeBtn_Click"/>
                    <Button Content="Сохранить игру" Margin="0,10" Height="40" FontSize="18" Click="SaveBtn_Click"/>
                    <Button Content="Главное меню" Margin="0,10" Height="40" FontSize="18" Click="MainMenuBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>