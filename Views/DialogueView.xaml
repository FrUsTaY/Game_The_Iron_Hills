<UserControl x:Class="EpicBattle.Views.DialogueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111111" KeyDown="UserControl_KeyDown" Focusable="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <!-- Фоновая сюжетная иллюстрация сцены -->
            <Image Name="BgImage" Stretch="UniformToFill" Opacity="0.95" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#100E0E12" Offset="0.0"/>
                        <GradientStop Color="#300E0E12" Offset="0.55"/>
                        <GradientStop Color="#850E0E12" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="30,20,30,25" MaxWidth="1140" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <!-- Верхняя панель: Подсказки/Кнопки -->
                    <RowDefinition Height="Auto"/>
                    <!-- Основное пространство -->
                    <RowDefinition Height="*"/>
                    <!-- Кнопки выбора -->
                    <RowDefinition Height="Auto"/>
                    <!-- Блок текста -->
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Кнопка меню паузы/сохранения -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Right">
                    <TextBlock Text="ESC - Меню паузы" Foreground="#CCCCCC" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Choices Panel -->
                <ItemsControl Name="ChoicesControl" Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Margin="0,5" Padding="24,12" Background="#E624242A" Foreground="White" BorderBrush="#777788" BorderThickness="1.5" Click="ChoiceBtn_Click" MaxWidth="900" Cursor="Hand">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" TextAlignment="Left" FontWeight="Medium"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Text Box -->
                <Border Grid.Row="3" Background="#E60F0F14" BorderBrush="#555566" BorderThickness="2" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Name="SpeakerText" Grid.Row="0" Text="Имя" Foreground="#FFAA00" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Name="DialogueText" Text="Текст диалога..." Foreground="White" FontSize="19" TextWrapping="Wrap" LineHeight="28"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Pause Menu Overlay -->
            <Border Name="PauseOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <TextBlock Text="ПАУЗА" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button Content="Продолжить" Margin="0,10" Height="40" FontSize="18" Click="ResumeBtn_Click"/>
                    <Button Content="Сохранить игру" Margin="0,10" Height="40" FontSize="18" Click="SaveBtn_Click"/>
                    <Button Content="Главное меню" Margin="0,10" Height="40" FontSize="18" Click="MainMenuBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
