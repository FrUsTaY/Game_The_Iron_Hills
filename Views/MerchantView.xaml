<UserControl x:Class="EpicBattle.Views.MerchantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#161616" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: ЗАГОЛОВОК И ЗОЛОТО -->
        <Border Grid.Row="0" Background="#202020" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💰" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ТОРГОВАЯ ЛАВКА СТРАННИКА" FontSize="20" FontWeight="Bold" Foreground="#FFAA00"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Индикаторы ресурсов -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2D2410" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 Золото: " Foreground="#FFCC00" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding PlayerGold}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E3A24" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding HpPotions, StringFormat='🧪 HP: {0}'}" Foreground="#55FF55" FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <Border Background="#1E2E4A" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding MpPotions, StringFormat='💧 MP: {0}'}" Foreground="#55AAFF" FontWeight="Bold" FontSize="14"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ: ТОВАРЫ ТОРГОВЦА И РАСХОДНИКИ / ПРОДАЖА -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: ВИТРИНА ТОРГОВЦА -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🛒 Товары на продажу:" FontSize="16" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,10"/>

                    <!-- Полка расходников и книг -->
                    <Border Grid.Row="1" Background="#222222" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <WrapPanel Orientation="Horizontal">
                            <Button Margin="4" Padding="10,6" Background="#2E4A2E" Click="BuyHpPotion_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧪 Зелье HP (+40)" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text=" (💰 20)" Foreground="#FFAA00"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="4" Padding="10,6" Background="#2E3A5A" Click="BuyMpPotion_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💧 Зелье MP (+25)" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text=" (💰 15)" Foreground="#FFAA00"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="4" Padding="10,6" Background="#5A3A1E" Click="BuyStatScroll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜 Свиток Силы (+1 Характеристика)" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text=" (💰 60)" Foreground="#FFAA00"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="4" Padding="10,6" Background="#4A2E5A" Click="BuySkillTome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖 Фолиант Знаний (+1 Навык)" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text=" (💰 75)" Foreground="#FFAA00"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- Список экипировки -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ShopItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242424" BorderBrush="{Binding RarityColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{Binding RarityColor}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StatsSummary}" FontSize="12" Foreground="#55FF55" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="{Binding PriceText, StringFormat='Купить ({0})'}"
                                                    Padding="15,8" FontSize="13" FontWeight="Bold" Background="#2E6B30"
                                                    Tag="{Binding}" Click="BuyItem_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ПРАВАЯ КОЛОНКА: СКУПКА (ИНВЕНТАРЬ ИГРОКА) -->
            <Border Grid.Column="1" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🎒 Скупка (Ваш инвентарь):" FontSize="16" FontWeight="Bold" Foreground="#88AAFF" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PlayerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{Binding RarityColor}"/>
                                                <TextBlock Text="{Binding StatsSummary}" FontSize="11" Foreground="LightGray"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="{Binding PriceText, StringFormat='Продать ({0})'}"
                                                    Padding="10,5" FontSize="12" Background="#6B302E"
                                                    Tag="{Binding}" Click="SellItem_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ: ВЫХОД ИЗ ЛАВКИ -->
        <Button Grid.Row="2" Content="🗺️ Покинуть лавку и продолжить путь" Height="45" Width="340" FontSize="15" FontWeight="Bold"
                Background="#443366" HorizontalAlignment="Center" Margin="0,15,0,0" Click="LeaveShop_Click"/>
    </Grid>
</UserControl>
