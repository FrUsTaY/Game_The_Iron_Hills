<UserControl x:Class="EpicBattle.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpicBattle.Views"
             xmlns:vm="clr-namespace:EpicBattle.ViewModels"
             Background="#1a1a1a"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <Grid Name="MainGrid" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Battle Arena Background (яркая, сочная батальная панорама на весь экран) -->
        <Image Source="{Binding BattleBackground}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.92" Grid.Row="0" Grid.RowSpan="5"/>
        <Border Background="#25100E14" Grid.Row="0" Grid.RowSpan="5"/>

        <!-- Верхняя панель: Волна и Пауза (центрирована на 1260px) -->
        <Grid Grid.Row="0" Margin="0,0,0,8" MaxWidth="1260" HorizontalAlignment="Stretch">
            <Border Background="#C014121A" BorderBrush="#4A3F54" BorderThickness="1.5" CornerRadius="6" Padding="14,5" HorizontalAlignment="Left">
                <TextBlock Text="{Binding WaveText}" Foreground="#FFAA00" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </Border>
            <Button x:Name="PauseButton" Click="PauseBtn_Click" Cursor="Hand" Background="#9514121A" BorderBrush="#3A3344" BorderThickness="1.5" Padding="14,5" HorizontalAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="ESC - Пауза" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BF24202C"/>
                                <Setter Property="BorderBrush" Value="#6A5A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Карточки бойцов (Игрок слева, Враги справа) - крупный Dark RPG лейаут -->
        <Grid Grid.Row="1" Margin="0,0,0,8" MaxWidth="1260" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Карточка Игрока (крупный внушительный формат) -->
            <Border Grid.Column="0" Background="#D5121118" BorderBrush="#4A3F55" BorderThickness="1.5" CornerRadius="10" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Парадный аватар героя (увеличенный формат 120x150) -->
                    <Border Grid.Column="0" Width="120" Height="150" CornerRadius="8" BorderBrush="#C89B3C" BorderThickness="2" ClipToBounds="True" Margin="0,0,16,0" VerticalAlignment="Center" Background="#1B1722">
                        <Image Source="{Binding PlayerAvatar}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Name="PlayerColumnHost" VerticalAlignment="Center">
                    <!-- Вспышка при получении удара -->
                    <Border Background="#44FF3333" CornerRadius="6" Opacity="0" Height="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayerHitPulse}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.45"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Шапка игрока: Имя слева, AP и Зелья справа -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding Player.Name}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#2E2414" BorderBrush="#775C28" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ AP: " Foreground="#FFFF77" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding Player.CurrentAP}" Foreground="#FFFF77" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="/" Foreground="#FFFF77" FontSize="12"/>
                                    <TextBlock Text="{Binding Player.MaxAP}" Foreground="#FFFF77" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1C3020" BorderBrush="#35663A" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0"
                                    ToolTip="{Binding Player.HpPotions, StringFormat='Запас зелий здоровья: {0} шт. (Восстанавливает +40 HP, расходует 1 AP)'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧪 " FontSize="13" Foreground="#55FF77" FontFamily="Segoe UI Emoji, Segoe UI Symbol"/>
                                    <TextBlock Text="{Binding Player.HpPotions}" Foreground="#AAFFAA" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A2238" BorderBrush="#33487A" BorderThickness="1" CornerRadius="5" Padding="8,4"
                                    ToolTip="{Binding Player.MpPotions, StringFormat='Запас зелий маны: {0} шт. (Восстанавливает +25 MP, расходует 1 AP)'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💧 " FontSize="13" Foreground="#66B2FF" FontFamily="Segoe UI Emoji, Segoe UI Symbol"/>
                                    <TextBlock Text="{Binding Player.MpPotions}" Foreground="#AAAAFF" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- HP игрока -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="ЗДОРОВЬЕ: " Foreground="#FF6666" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding Player.Hp}" Foreground="#FF6666" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text=" / " Foreground="#FF6666" FontSize="13"/>
                        <TextBlock Text="{Binding Player.MaxHp}" Foreground="#FF6666" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Player.Hp}" Maximum="{Binding Player.MaxHp}" Height="22" Foreground="#E53935" Background="#26181B" BorderThickness="0" Margin="0,0,0,8"/>

                    <!-- MP игрока -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="МАНА: " Foreground="#5599FF" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding Player.Mp}" Foreground="#5599FF" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text=" / " Foreground="#5599FF" FontSize="13"/>
                        <TextBlock Text="{Binding Player.MaxMp}" Foreground="#5599FF" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Player.Mp}" Maximum="{Binding Player.MaxMp}" Height="14" Foreground="#1E88E5" Background="#161B2B" BorderThickness="0" Margin="0,0,0,6"/>

                    <!-- Статусы игрока -->
                    <ItemsControl ItemsSource="{Binding Player.ActiveEffects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,0">
                                    <TextBlock Text="{Binding IconPath}" FontSize="16" ToolTip="{Binding Name}"/>
                                    <Border Background="#CC000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="3,1">
                                        <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#60181422" BorderBrush="#4A3D5A" BorderThickness="1" CornerRadius="12" Padding="8,12">
                <TextBlock Text="VS" Foreground="#9587AA" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Враги (Список карточек) -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Enemies}" Name="EnemiesHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="EnemyBorder" BorderBrush="#4A3F55" BorderThickness="1.5" Margin="0,0,0,6" Padding="12,8" Background="#D5161420" CornerRadius="10">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Path=DataContext.SelectTargetCommand}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Аватар врага (крупный формат 82x104) -->
                                <Border Grid.Column="0" Width="82" Height="104" CornerRadius="8" BorderBrush="#6B4F6E" BorderThickness="2" ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Center" Background="#1D1722">
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка намерения -->
                                    <Border Grid.Column="0" Background="#302438" BorderBrush="#5E436E" BorderThickness="1" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" ToolTip="{Binding CurrentIntent.Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentIntent.IconPath}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="#FFAA00" FontSize="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding CurrentIntent.Description}" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Имя врага -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,3">
                                    <TextBlock Text="HP: " Foreground="#FF6666" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding Hp}" Foreground="#FF6666" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text=" / " Foreground="#FF6666" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding MaxHp}" Foreground="#FF6666" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                
                                <ProgressBar Value="{Binding Hp}" Maximum="{Binding MaxHp}" Height="16" HorizontalAlignment="Stretch" Foreground="#E53935" Background="#26181B" BorderThickness="0" Margin="0,0,0,6">
                                    <ProgressBar.LayoutTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </ProgressBar.LayoutTransform>
                                </ProgressBar>

                                <!-- Статусы врага -->
                                <ItemsControl ItemsSource="{Binding ActiveEffects}" HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,6,0">
                                                <TextBlock Text="{Binding IconPath}" FontSize="16" ToolTip="{Binding Name}"/>
                                                <Border Background="#CC000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="3,1">
                                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTargeted}" Value="True">
                                <Setter TargetName="EnemyBorder" Property="BorderBrush" Value="#FF4D4D" />
                                <Setter TargetName="EnemyBorder" Property="Background" Value="#E0381E24" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Центральная батальная зона (открытый обзор поля боя для анимаций, урона и фонового арта) -->
        <Grid Grid.Row="2" Margin="0,4"/>

        <!-- Резервная строка для совместимости Grid.RowSpan="5" -->
        <Grid Grid.Row="3"/>

        <!-- Нижний командный мостик: объединённая панель статуса, навыков, действий и компактного лога боя (центрирована на 1260px) -->
        <Border Grid.Row="4" Background="#E0121018" BorderBrush="#5A4736" BorderThickness="1.5" CornerRadius="10" Padding="14,10" MaxWidth="1260" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Левая секция: Статус, Навыки, Кнопки действий -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Статус хода -->
                    <Border Background="#332415" BorderBrush="#725528" BorderThickness="1" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚔️ " FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFAA00" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Активные навыки игрока (с индикацией перезарядки Вариант 1) -->
                    <ItemsControl ItemsSource="{Binding PlayerSkills}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,6" Padding="10,6"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Path=DataContext.UseSkillCommand}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder" Background="#26364D" BorderBrush="#4A6E9E" BorderThickness="1.5" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#354B6B"/>
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#6A92D4"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsOnCooldown}" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#171A22"/>
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3A404F"/>
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsOnCooldown}" Value="True"/>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#222631"/>
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#525B6F"/>
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="1.0"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" Foreground="#FFAA00" FontWeight="Bold" FontSize="13" Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" MaxWidth="280"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnCooldown}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Расход: " Foreground="#888888" FontSize="11"/>
                                                    <TextBlock Text="{Binding APCost, StringFormat='⚡ {0} AP'}" Foreground="#FFFF77" FontWeight="Bold" FontSize="11" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding ManaCost, StringFormat='💧 {0} MP'}" Foreground="#66B2FF" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                                <Border Background="#332412" BorderBrush="#8A6020" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,3,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnCooldown}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CooldownRemaining, StringFormat='⏳ Навык на перезарядке. Осталось ходов: {0}'}" Foreground="#FFCC44" FontWeight="Bold" FontSize="11"/>
                                                        <TextBlock Margin="0,2,0,0" Foreground="#AAAAAA" FontSize="11">
                                                            <Run Text="Требуется: "/>
                                                            <Run Text="{Binding APCost, Mode=OneWay, StringFormat='⚡ {0} AP'}" Foreground="#FFFF77" FontWeight="Bold"/>
                                                            <Run Text=", "/>
                                                            <Run Text="{Binding ManaCost, Mode=OneWay, StringFormat='💧 {0} MP'}" Foreground="#66B2FF" FontWeight="Bold"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconPath}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnCooldown}" Value="True">
                                                            <Setter Property="Foreground" Value="#C2C6D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                        <!-- Когда навык ГОТОВ: показываем затраты AP и Маны -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnCooldown}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding APCost, StringFormat='⚡{0}'}" Foreground="#FFFF77" FontWeight="Bold" FontSize="12" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding ManaCost, StringFormat='💧{0}'}" Foreground="#66B2FF" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>

                                        <!-- Когда навык НА ПЕРЕЗАРЯДКЕ: янтарный бейдж (Вариант 1) -->
                                        <Border Background="#3D2610" BorderBrush="#9E6820" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnCooldown}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CooldownRemaining, StringFormat='⏳ {0} ход.'}" Foreground="#FFD055" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Основные кнопки действий -->
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="⚔️ Удар" ToolTip="Атака оружием (2 AP)" Margin="0,0,8,0" MinWidth="110" Height="42" FontSize="13" FontWeight="Bold" Background="#3E2E28" Command="{Binding AttackCommand}" Cursor="Hand"/>
                        <Button Content="🛡️ Защита" ToolTip="Снижение получаемого урона (2 AP)" Margin="0,0,8,0" MinWidth="110" Height="42" FontSize="13" FontWeight="Bold" Background="#263A48" Command="{Binding DefendCommand}" Cursor="Hand"/>
                        <Button Content="🧪 Зелье HP" ToolTip="Выпить зелье здоровья: +40 HP (Расход: 1 AP)" Margin="0,0,8,0" MinWidth="110" Height="42" FontSize="13" FontWeight="Bold" Background="#223E26" Command="{Binding UsePotionHpCommand}" Cursor="Hand"/>
                        <Button Content="💧 Зелье MP" ToolTip="Выпить зелье маны: +25 MP (Расход: 1 AP)" Margin="0,0,8,0" MinWidth="110" Height="42" FontSize="13" FontWeight="Bold" Background="#212C48" Command="{Binding UsePotionMpCommand}" Cursor="Hand"/>
                        <Button Content="⌛ Конец хода" ToolTip="Передать ход врагам (сброс неиспользованных AP)" Margin="0,0,0,0" MinWidth="130" Height="42" FontSize="13" FontWeight="Bold" Background="#6B2C2C" Command="{Binding EndTurnCommand}" Cursor="Hand"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Правая секция: Компактный лог боя -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="📜 ЖУРНАЛ БОЯ" Foreground="#D5C5A5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="⛶ Полный лог" FontSize="11" Padding="8,3" Height="24" HorizontalAlignment="Right" Background="#2B273A" Foreground="#EEE" BorderBrush="#534A62" Click="OpenFullLog_Click" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#90090810" BorderBrush="#3F3748" BorderThickness="1.5" CornerRadius="6" Height="108">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Name="LogScroller">
                            <ItemsControl ItemsSource="{Binding CombatLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor, FallbackValue='#E0E0E0'}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Оверлей полной истории боя -->
        <Border Name="FullLogOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#C0000000" Visibility="Collapsed" Panel.ZIndex="120">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1C1A22" BorderBrush="#FFAA00" BorderThickness="1.5" CornerRadius="8" Width="680" Height="480" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📜 Полная история сражения" Foreground="#FFAA00" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Background="#3A2828" Click="CloseFullLog_Click" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#0F0E13" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Name="FullLogScroller">
                            <ItemsControl ItemsSource="{Binding CombatLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor, FallbackValue='#E0E0E0'}" FontSize="13" TextWrapping="Wrap" Margin="4,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2" Content="Закрыть (Esc)" HorizontalAlignment="Right" Width="120" Height="34" Margin="0,10,0,0" Click="CloseFullLog_Click" Cursor="Hand"/>
                </Grid>
            </Border>
        </Border>

        <!-- Оверлей прокачки после победы -->
        <Border Name="UpgradeOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Panel.ZIndex="50">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpgradeOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" BorderBrush="#FFAA00" BorderThickness="2" CornerRadius="8" Width="620" Padding="25">
                <StackPanel>
                    <TextBlock Text="🏆 ПОБЕДА! УРОВЕНЬ ПОВЫШЕН!" Foreground="#FFAA00" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Распределите характеристики и изучите новые навыки:" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Сводка очков -->
                    <Border Background="#181818" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Уровень: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayerLevel}" Foreground="#FFAA00" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Очки характеристик: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatPoints}" Foreground="#55FF55" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Очки навыков: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SkillPoints}" Foreground="#55AAFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Сводка добычи (Лут и Золото) -->
                    <Border Background="#1A2A1A" BorderBrush="#2E6B30" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="🎁 НАЙДЕННЫЕ ТРОФЕИ:" Foreground="#FFAA00" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LootSummaryText}" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding DroppedLoot}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#242424" BorderBrush="{Binding RarityColor}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconPath}" FontSize="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding RarityColor}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding FormattedStats, StringFormat=' ({0})'}" Foreground="LightGray" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки распределения статов -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Сила -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сила" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Strength, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding PlayerBaseDamage, StringFormat='Физ. урон: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="STR"/>
                            </Grid>
                        </Border>

                        <!-- Ловкость -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ловкость" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Dexterity, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding CritChance, StringFormat='Крит/Уклон: {0:F0}% • Инициатива'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="DEX"/>
                            </Grid>
                        </Border>

                        <!-- Интеллект -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Интеллект" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Intelligence, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding PlayerBaseMagicDamage, StringFormat='Маг. урон: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="INT"/>
                            </Grid>
                        </Border>

                        <!-- Выносливость -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Выносливость" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Endurance, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding Defense, StringFormat='Защита: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="END"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Кнопка перехода к дереву навыков -->
                    <Button Content="🌳 Изучить навыки в Древе Талантов" Margin="5,0,5,10" Height="38" FontSize="14" Background="#334466" Command="{Binding OpenSkillTreeCommand}"/>
                    <Button Content="🎒 Осмотреть инвентарь и надеть лут" Margin="5,0,5,10" Height="38" FontSize="14" Background="#4A3A2E" Command="{Binding OpenInventoryCommand}"/>

                    <!-- Кнопки продолжения в зависимости от режима -->
                    <Button Content="➡️ Продолжить (Сюжет)" Margin="0,10,0,0" Height="45" FontSize="16" Background="#28a745" Command="{Binding ContinueStoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStoryMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🗺️ Вернуться на Карту Похода" Margin="0,10,0,0" Height="45" FontSize="16" FontWeight="Bold" Background="#2E6B30" Command="{Binding ReturnToMapCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="⚔️ Следующий бой (Аркада)" Margin="0,10,0,0" Height="45" FontSize="16" Background="#28a745" Command="{Binding NextBattleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArcadeMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- P0-фикс (Б1): экран поражения -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#E6000000" Panel.ZIndex="200">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayerDead}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2A1515" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Width="360" Padding="24">
                <StackPanel>
                    <TextBlock Text="💀 ПОРАЖЕНИЕ" Foreground="#FF4444" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Ваш герой пал в бою. Прогресс сохранён на последнем контрольном пункте." Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Вернуться в главное меню" Command="{Binding ReturnToMenuCommand}" Height="40" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Меню Паузы -->
        <Border Name="PauseOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Width="300" Padding="20">
                <StackPanel>
                    <TextBlock Text="ПАУЗА" Foreground="#FFAA00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Продолжить" Margin="0,5" Height="35" Click="ResumeBtn_Click"/>
                    <Button Content="Главное меню" Margin="0,5" Height="35" Click="MainMenuBtn_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>