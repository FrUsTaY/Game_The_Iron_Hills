<UserControl x:Class="EpicBattle.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpicBattle.Views"
             xmlns:vm="clr-namespace:EpicBattle.ViewModels"
             Background="#1a1a1a"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <Grid Name="MainGrid" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Battle Arena Background (яркая, сочная батальная панорама на весь экран) -->
        <Image Source="{Binding BattleBackground}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.92" Grid.Row="0" Grid.RowSpan="5"/>
        <Border Background="#25100E14" Grid.Row="0" Grid.RowSpan="5"/>

        <!-- Верхняя панель: Волна и Пауза -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Border Background="#B014121A" BorderBrush="#3A3442" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Left">
                <TextBlock Text="{Binding WaveText}" Foreground="#FFAA00" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </Border>
            <Border Background="#8014121A" BorderBrush="#332E3A" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Right">
                <TextBlock Text="ESC - Пауза" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Карточки бойцов (Игрок слева, Враги справа) -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Карточка Игрока -->
            <Border Grid.Column="0" Background="#C8121118" BorderBrush="#3D3746" BorderThickness="1.5" CornerRadius="8" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Аватар героя -->
                    <Border Grid.Column="0" Width="48" Height="58" CornerRadius="6" BorderBrush="#554466" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="{Binding PlayerAvatar}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Name="PlayerColumnHost">
                    <!-- Этап 3.3: вспышка при получении удара (импульс из VM) -->
                    <Border Background="#44FF3333" CornerRadius="6" Opacity="0" Height="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayerHitPulse}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.45"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Шапка игрока: Имя слева, AP и Зелья справа -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{Binding Player.Name}" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#2A2415" BorderBrush="#554420" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ AP: " Foreground="#FFFF66" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding Player.CurrentAP}" Foreground="#FFFF66" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="/" Foreground="#FFFF66" FontSize="11"/>
                                    <TextBlock Text="{Binding Player.MaxAP}" Foreground="#FFFF66" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#182A1A" BorderBrush="#2E5530" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0" ToolTip="Зелья здоровья (1 ОД)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧪 " FontSize="11"/>
                                    <TextBlock Text="{Binding Player.HpPotions}" Foreground="#AAFFAA" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#181E30" BorderBrush="#2E3C66" BorderThickness="1" CornerRadius="4" Padding="5,2" ToolTip="Зелья маны (1 ОД)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💧 " FontSize="11"/>
                                    <TextBlock Text="{Binding Player.MpPotions}" Foreground="#AAAAFF" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- HP игрока -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="HP: " Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding Player.Hp}" Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text=" / " Foreground="#FF5555" FontSize="11"/>
                        <TextBlock Text="{Binding Player.MaxHp}" Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Player.Hp}" Maximum="{Binding Player.MaxHp}" Height="12" Foreground="#FF5555" Background="#282226" BorderThickness="0" Margin="0,0,0,4"/>

                    <!-- MP игрока -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="MP: " Foreground="#5588FF" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding Player.Mp}" Foreground="#5588FF" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text=" / " Foreground="#5588FF" FontSize="11"/>
                        <TextBlock Text="{Binding Player.MaxMp}" Foreground="#5588FF" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Player.Mp}" Maximum="{Binding Player.MaxMp}" Height="8" Foreground="#5588FF" Background="#20222E" BorderThickness="0" Margin="0,0,0,4"/>

                    <!-- Статусы игрока -->
                    <ItemsControl ItemsSource="{Binding Player.ActiveEffects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,5,0">
                                    <TextBlock Text="{Binding IconPath}" FontSize="15" ToolTip="{Binding Name}"/>
                                    <Border Background="#AA000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="2,0">
                                        <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Column="1" Text="VS" Foreground="#665D73" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Враги (Список карточек) -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Enemies}" Name="EnemiesHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="EnemyBorder" BorderBrush="#3D3746" BorderThickness="1.5" Margin="0,0,0,6" Padding="10,6" Background="#C8181620" CornerRadius="8">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Path=DataContext.SelectTargetCommand}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Аватар врага -->
                                <Border Grid.Column="0" Width="48" Height="58" CornerRadius="6" BorderBrush="#554455" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                                    <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка намерения -->
                                    <Border Grid.Column="0" Background="#2A2430" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" ToolTip="{Binding CurrentIntent.Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentIntent.IconPath}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="#FFAA00" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding CurrentIntent.Description}" Foreground="#AAAAAA" FontSize="10"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Имя врага -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                                    <TextBlock Text="HP: " Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding Hp}" Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text=" / " Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding MaxHp}" Foreground="#FF5555" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                
                                <ProgressBar Value="{Binding Hp}" Maximum="{Binding MaxHp}" Height="12" HorizontalAlignment="Stretch" Foreground="#FF5555" Background="#282226" BorderThickness="0" Margin="0,0,0,4">
                                    <ProgressBar.LayoutTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </ProgressBar.LayoutTransform>
                                </ProgressBar>

                                <!-- Статусы врага -->
                                <ItemsControl ItemsSource="{Binding ActiveEffects}" HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,5,0">
                                                <TextBlock Text="{Binding IconPath}" FontSize="15" ToolTip="{Binding Name}"/>
                                                <Border Background="#AA000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="2,0">
                                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTargeted}" Value="True">
                                <Setter TargetName="EnemyBorder" Property="BorderBrush" Value="#FF5555" />
                                <Setter TargetName="EnemyBorder" Property="Background" Value="#D0332228" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Центральная батальная зона (открытый обзор поля боя для анимаций, урона и фонового арта) -->
        <Grid Grid.Row="2" Margin="0,4"/>

        <!-- Резервная строка для совместимости Grid.RowSpan="5" -->
        <Grid Grid.Row="3"/>

        <!-- Нижний командный мостик: объединённая панель статуса, навыков, действий и компактного лога боя -->
        <Border Grid.Row="4" Background="#D5121018" BorderBrush="#4A3E34" BorderThickness="1.5" CornerRadius="8" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Левая секция: Статус, Навыки, Кнопки действий -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Статус хода -->
                    <Border Background="#2E2316" BorderBrush="#5E4924" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚔️ " FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFAA00" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Активные навыки игрока -->
                    <ItemsControl ItemsSource="{Binding PlayerSkills}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Padding="8,4"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Path=DataContext.UseSkillCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#334466">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconPath}" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="{Binding ManaCost, StringFormat='{} • {0} 💧'}" Foreground="#55AAFF" Margin="4,0,0,0" ToolTip="{Binding APCost, StringFormat='Расход очков действий: {0} ОД'}" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Основные кнопки действий -->
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="⚔️ Удар" ToolTip="Атака оружием (2 ОД)" Margin="0,0,6,0" MinWidth="100" Height="36" FontWeight="SemiBold" Command="{Binding AttackCommand}"/>
                        <Button Content="🛡️ Защита" ToolTip="Снижение получаемого урона (2 ОД)" Margin="0,0,6,0" MinWidth="100" Height="36" FontWeight="SemiBold" Command="{Binding DefendCommand}"/>
                        <Button Content="🧪 Зелье HP" ToolTip="Восстановить здоровье (1 ОД)" Margin="0,0,6,0" MinWidth="100" Height="36" FontWeight="SemiBold" Command="{Binding UsePotionHpCommand}"/>
                        <Button Content="💧 Зелье MP" ToolTip="Восстановить ману (1 ОД)" Margin="0,0,6,0" MinWidth="100" Height="36" FontWeight="SemiBold" Command="{Binding UsePotionMpCommand}"/>
                        <Button Content="⌛ Завершить ход" Margin="0,0,0,0" MinWidth="120" Height="36" FontWeight="Bold" Background="#5A2E2E" Command="{Binding EndTurnCommand}"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Правая секция: Компактный лог боя -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="📜 ЖУРНАЛ БОЯ" Foreground="#C8BD9C" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="⛶ Полный лог" FontSize="10" Padding="6,2" Height="20" HorizontalAlignment="Right" Background="#282634" Foreground="#DDD" BorderBrush="#4B4456" Click="OpenFullLog_Click" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#8008080E" BorderBrush="#36303E" BorderThickness="1" CornerRadius="5" Height="95">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Name="LogScroller">
                            <ItemsControl ItemsSource="{Binding CombatLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor, FallbackValue='#E0E0E0'}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="6,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Оверлей полной истории боя -->
        <Border Name="FullLogOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#C0000000" Visibility="Collapsed" Panel.ZIndex="120">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1C1A22" BorderBrush="#FFAA00" BorderThickness="1.5" CornerRadius="8" Width="680" Height="480" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📜 Полная история сражения" Foreground="#FFAA00" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Background="#3A2828" Click="CloseFullLog_Click" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#0F0E13" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Name="FullLogScroller">
                            <ItemsControl ItemsSource="{Binding CombatLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor, FallbackValue='#E0E0E0'}" FontSize="13" TextWrapping="Wrap" Margin="4,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2" Content="Закрыть (Esc)" HorizontalAlignment="Right" Width="120" Height="34" Margin="0,10,0,0" Click="CloseFullLog_Click" Cursor="Hand"/>
                </Grid>
            </Border>
        </Border>

        <!-- Оверлей прокачки после победы -->
        <Border Name="UpgradeOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Panel.ZIndex="50">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpgradeOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" BorderBrush="#FFAA00" BorderThickness="2" CornerRadius="8" Width="620" Padding="25">
                <StackPanel>
                    <TextBlock Text="🏆 ПОБЕДА! УРОВЕНЬ ПОВЫШЕН!" Foreground="#FFAA00" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Распределите характеристики и изучите новые навыки:" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Сводка очков -->
                    <Border Background="#181818" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Уровень: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayerLevel}" Foreground="#FFAA00" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Очки характеристик: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatPoints}" Foreground="#55FF55" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Очки навыков: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SkillPoints}" Foreground="#55AAFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Сводка добычи (Лут и Золото) -->
                    <Border Background="#1A2A1A" BorderBrush="#2E6B30" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="🎁 НАЙДЕННЫЕ ТРОФЕИ:" Foreground="#FFAA00" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LootSummaryText}" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding DroppedLoot}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#242424" BorderBrush="{Binding RarityColor}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconPath}" FontSize="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding RarityColor}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding FormattedStats, StringFormat=' ({0})'}" Foreground="LightGray" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки распределения статов -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Сила -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сила" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Strength, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding PlayerBaseDamage, StringFormat='Физ. урон: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="STR"/>
                            </Grid>
                        </Border>

                        <!-- Ловкость -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ловкость" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Dexterity, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding CritChance, StringFormat='Крит / Уклон: {0:F0}%'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="DEX"/>
                            </Grid>
                        </Border>

                        <!-- Интеллект -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Интеллект" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Intelligence, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding PlayerBaseMagicDamage, StringFormat='Маг. урон: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="INT"/>
                            </Grid>
                        </Border>

                        <!-- Выносливость -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Выносливость" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Endurance, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding Defense, StringFormat='Защита: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="END"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Кнопка перехода к дереву навыков -->
                    <Button Content="🌳 Изучить навыки в Древе Талантов" Margin="5,0,5,10" Height="38" FontSize="14" Background="#334466" Command="{Binding OpenSkillTreeCommand}"/>
                    <Button Content="🎒 Осмотреть инвентарь и надеть лут" Margin="5,0,5,10" Height="38" FontSize="14" Background="#4A3A2E" Command="{Binding OpenInventoryCommand}"/>

                    <!-- Кнопки продолжения в зависимости от режима -->
                    <Button Content="➡️ Продолжить (Сюжет)" Margin="0,10,0,0" Height="45" FontSize="16" Background="#28a745" Command="{Binding ContinueStoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStoryMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🗺️ Вернуться на Карту Похода" Margin="0,10,0,0" Height="45" FontSize="16" FontWeight="Bold" Background="#2E6B30" Command="{Binding ReturnToMapCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="⚔️ Следующий бой (Аркада)" Margin="0,10,0,0" Height="45" FontSize="16" Background="#28a745" Command="{Binding NextBattleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArcadeMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- P0-фикс (Б1): экран поражения -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#E6000000" Panel.ZIndex="200">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayerDead}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2A1515" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Width="360" Padding="24">
                <StackPanel>
                    <TextBlock Text="💀 ПОРАЖЕНИЕ" Foreground="#FF4444" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Ваш герой пал в бою. Прогресс сохранён на последнем контрольном пункте." Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Вернуться в главное меню" Command="{Binding ReturnToMenuCommand}" Height="40" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Меню Паузы -->
        <Border Name="PauseOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Width="300" Padding="20">
                <StackPanel>
                    <TextBlock Text="ПАУЗА" Foreground="#FFAA00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Продолжить" Margin="0,5" Height="35" Click="ResumeBtn_Click"/>
                    <Button Content="Главное меню" Margin="0,5" Height="35" Click="MainMenuBtn_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>