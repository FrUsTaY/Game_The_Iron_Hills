<UserControl x:Class="EpicBattle.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EpicBattle.ViewModels"
             Background="#1E1E1E" KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Margin="20" Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,0,0,10">
            <TextBlock Text="ESC - Пауза" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Игрок -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Player.Name}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

                <!-- HP -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HP: " Foreground="#FF5555" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.Hp}" Foreground="#FF5555" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#FF5555" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.MaxHp}" Foreground="#FF5555" FontWeight="Bold"/>
                </StackPanel>
                <ProgressBar Value="{Binding Player.Hp}" Maximum="{Binding Player.MaxHp}" Height="15" Foreground="#FF5555" Background="#333333" BorderThickness="0" Margin="0,0,0,5"/>

                <!-- MP -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MP: " Foreground="#5555FF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.Mp}" Foreground="#5555FF" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#5555FF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.MaxMp}" Foreground="#5555FF" FontWeight="Bold"/>
                </StackPanel>
                <ProgressBar Value="{Binding Player.Mp}" Maximum="{Binding Player.MaxMp}" Height="10" Foreground="#5555FF" Background="#333333" BorderThickness="0" Margin="0,0,0,5"/>

                <!-- AP и зелья -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="AP: " Foreground="#FFFF55" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.CurrentAP}" Foreground="#FFFF55" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#FFFF55" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.MaxAP}" Foreground="#FFFF55" FontWeight="Bold" Margin="0,0,15,0"/>

                    <TextBlock Text="🧪 HP: " Foreground="#AAFFAA"/>
                    <TextBlock Text="{Binding Player.HpPotions}" Foreground="#AAFFAA" Margin="0,0,15,0"/>

                    <TextBlock Text="💧 MP: " Foreground="#AAAAFF"/>
                    <TextBlock Text="{Binding Player.MpPotions}" Foreground="#AAAAFF"/>
                </StackPanel>

                <!-- Статусы игрока -->
                <ItemsControl ItemsSource="{Binding Player.ActiveEffects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,5,0">
                                <TextBlock Text="{Binding IconPath}" FontSize="16" ToolTip="{Binding Name}"/>
                                <Border Background="#AA000000" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="2,0">
                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="VS" Foreground="Gray" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Враги (Список) -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Enemies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="EnemyBorder" BorderBrush="#333333" BorderThickness="2" Margin="5" Padding="5" Background="#222">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.SelectTargetCommand}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Right" Width="250">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentIntent.IconPath}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="White" FontSize="16" Margin="0,0,5,0" ToolTip="{Binding CurrentIntent.Description}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="HP: " Foreground="#FF5555" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Hp}" Foreground="#FF5555" FontWeight="Bold"/>
                                    <TextBlock Text=" / " Foreground="#FF5555" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MaxHp}" Foreground="#FF5555" FontWeight="Bold"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding Hp}" Maximum="{Binding MaxHp}" Height="15" HorizontalAlignment="Stretch" Foreground="#FF5555" Background="#333333" BorderThickness="0" Margin="0,0,0,5">
                                    <ProgressBar.LayoutTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </ProgressBar.LayoutTransform>
                                </ProgressBar>

                                <!-- Статусы врага -->
                                <ItemsControl ItemsSource="{Binding ActiveEffects}" HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5,0,0,0">
                                                <TextBlock Text="{Binding IconPath}" FontSize="16" ToolTip="{Binding Name}"/>
                                                <Border Background="#AA000000" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="2,0">
                                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTargeted}" Value="True">
                                <Setter TargetName="EnemyBorder" Property="BorderBrush" Value="#FF5555" />
                                <Setter TargetName="EnemyBorder" Property="Background" Value="#332222" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Лог Боя -->
        <Border Grid.Row="2" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Name="LogScroller">
                <ItemsControl ItemsSource="{Binding CombatLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor}" FontSize="14" TextWrapping="Wrap" Margin="10,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Статус -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#FFAA00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Панель действий -->
        <StackPanel Grid.Row="4" Orientation="Vertical">
            <ItemsControl ItemsSource="{Binding PlayerSkills}" HorizontalAlignment="Center" Margin="0,0,0,5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="5" Height="40" Padding="10,0"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.UseSkillCommand}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Description}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text=" (" Foreground="LightGray"/>
                                <TextBlock Text="{Binding APCost}" Foreground="#FFFF55"/>
                                <TextBlock Text="AP / " Foreground="LightGray"/>
                                <TextBlock Text="{Binding ManaCost}" Foreground="#5555FF"/>
                                <TextBlock Text="MP)" Foreground="LightGray"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="⚔️ Удар (2 AP)" Margin="5" Command="{Binding AttackCommand}" Width="120" Height="40"/>
                <Button Content="🛡 Защита (2 AP)" Margin="5" Command="{Binding DefendCommand}" Width="120" Height="40"/>
                <Button Content="🧪 Зелье HP (1 AP)" Margin="5" Command="{Binding UsePotionHpCommand}" Width="130" Height="40"/>
                <Button Content="💧 Зелье MP (1 AP)" Margin="5" Command="{Binding UsePotionMpCommand}" Width="130" Height="40"/>
                <Button Content="⏳ Завершить ход" Margin="5" Command="{Binding EndTurnCommand}" Width="130" Height="40" Background="#553333"/>
                <Button Content="🔄 В меню" Margin="5" Command="{Binding ReturnToMenuCommand}" Background="#551111" Width="120" Height="40">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayerDead}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
        </StackPanel>

        <!-- Upgrade Overlay -->
        <Border Name="UpgradeOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Panel.ZIndex="50">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpgradeOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" Width="600" Padding="20">
                <StackPanel>
                    <TextBlock Text="ПОБЕДА!" Foreground="#FFAA00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Выберите награду и прокачайтесь:" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <UniformGrid Columns="3" Rows="1" Height="150" Name="UpgradeGrid">
                        <Button Margin="10" Command="{Binding UpgradeCommand}" CommandParameter="Damage">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUpgrade}" Value="Damage">
                                            <Setter Property="Background" Value="#28a745"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="Урон" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="+5 к Урону" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="10" Command="{Binding UpgradeCommand}" CommandParameter="Health">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUpgrade}" Value="Health">
                                            <Setter Property="Background" Value="#28a745"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="Здоровье" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="+20 к HP" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="10" Command="{Binding UpgradeCommand}" CommandParameter="Potions">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUpgrade}" Value="Potions">
                                            <Setter Property="Background" Value="#28a745"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="Зелья" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Восстановить все" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Очки характеристик (осталось): " Foreground="LightGreen" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatPoints}" Foreground="LightGreen" FontSize="16" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Очки навыков: " Foreground="LightBlue" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SkillPoints}" Foreground="LightBlue" FontSize="16" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="Открыть Дерево Навыков" Margin="0,20,0,0" Height="50" FontSize="18" Background="#444" Command="{Binding OpenSkillTreeCommand}"/>

                    <!-- Кнопки продолжения в зависимости от режима -->
                    <Button Content="Продолжить (Сюжет)" Margin="0,10,0,0" Height="50" FontSize="18" Background="#28a745" Command="{Binding ContinueStoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsStoryMode}" Value="True"/>
                                            <Condition Binding="{Binding CanUpgrade}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsStoryMode}" Value="True"/>
                                            <Condition Binding="{Binding CanUpgrade}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Следующий бой (Аркада)" Margin="0,10,0,0" Height="50" FontSize="18" Background="#28a745" Command="{Binding NextBattleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsArcadeMode}" Value="True"/>
                                            <Condition Binding="{Binding CanUpgrade}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsArcadeMode}" Value="True"/>
                                            <Condition Binding="{Binding CanUpgrade}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- Pause Menu Overlay -->
        <Border Name="PauseOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <TextBlock Text="ПАУЗА" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="Продолжить" Margin="0,10" Height="40" FontSize="18" Click="ResumeBtn_Click"/>
                <Button Content="Главное меню" Margin="0,10" Height="40" FontSize="18" Click="MainMenuBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>