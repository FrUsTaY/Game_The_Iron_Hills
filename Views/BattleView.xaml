<UserControl x:Class="EpicBattle.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" KeyDown="UserControl_KeyDown" Focusable="True">
    <Grid Margin="20" Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,0,0,10">
            <TextBlock Text="ESC - Пауза" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Name="PlayerLevelText" Text="⚔️ Воин (Уровень 1)" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Name="PlayerHpText" Text="HP: 100 / 100" Foreground="#FF5555" FontWeight="Bold"/>
                <ProgressBar Name="PlayerHpBar" Value="100" Maximum="100" Height="15" Foreground="#FF5555" Background="#333333" BorderThickness="0" Margin="0,0,0,5"/>
                <TextBlock Name="PlayerMpText" Text="MP: 50 / 50" Foreground="#5555FF" FontWeight="Bold"/>
                <ProgressBar Name="PlayerMpBar" Value="50" Maximum="50" Height="10" Foreground="#5555FF" Background="#333333" BorderThickness="0" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="HpPotionText" Text="🧪 Зелья HP: 3" Foreground="#AAFFAA" Margin="0,0,15,0"/>
                    <TextBlock Name="MpPotionText" Text="💧 Зелья MP: 2" Foreground="#AAAAFF"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="VS" Foreground="Gray" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Width="300">
                <TextBlock Name="EnemyNameText" Text="👹 Орк-грабитель" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Right"/>
                <TextBlock Name="EnemyHpText" Text="HP: 80 / 80" Foreground="#FF5555" FontWeight="Bold" HorizontalAlignment="Right"/>
                <ProgressBar Name="EnemyHpBar" Value="80" Maximum="80" Height="15" Foreground="#FF5555" Background="#333333" BorderThickness="0" Margin="0,0,0,5">
                    <ProgressBar.LayoutTransform>
                        <ScaleTransform ScaleX="-1"/>
                    </ProgressBar.LayoutTransform>
                </ProgressBar>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
            <ScrollViewer Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock Name="EventLog" Foreground="#DDDDDD" FontSize="14" TextWrapping="Wrap" Margin="10" Text=""/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Name="StatusText" Text="Ваш ход!" Foreground="#FFAA00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <WrapPanel Grid.Row="4" Name="ActionPanel" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Name="AttackBtn" Content="⚔️ Удар" Margin="5" Click="AttackBtn_Click"/>
            <Button Name="DefendBtn" Content="🛡 Защита" Margin="5" Click="DefendBtn_Click"/>
            <Button Name="MagicBtn" Content="✨ Руна Огня (10 MP)" Margin="5" Click="MagicBtn_Click"/>
            <Button Name="PotionHpBtn" Content="🧪 Зелье HP" Margin="5" Click="PotionHpBtn_Click"/>
            <Button Name="PotionMpBtn" Content="💧 Зелье MP" Margin="5" Click="PotionMpBtn_Click"/>
            <Button Name="NewGameBtn" Content="🔄 В меню" Margin="5" Click="NewGameBtn_Click" Visibility="Collapsed" Background="#551111"/>
        </WrapPanel>

        <!-- Upgrade Overlay -->
        <Border Name="UpgradeOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="50">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" Width="600" Padding="20">
                <StackPanel>
                    <TextBlock Name="WinTitleText" Text="УРОВЕНЬ ПРОЙДЕН!" Foreground="#FFAA00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Name="WinSubTitleText" Text="Выберите награду:" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <UniformGrid Columns="3" Rows="1" Height="200" Name="UpgradeGrid">
                        <Button Name="Upgrade1Btn" Content="Урон" Margin="10" Click="UpgradeBtn_Click"/>
                        <Button Name="Upgrade2Btn" Content="Здоровье" Margin="10" Click="UpgradeBtn_Click"/>
                        <Button Name="Upgrade3Btn" Content="Зелья" Margin="10" Click="UpgradeBtn_Click"/>
                    </UniformGrid>

                    <Button Name="ContinueStoryBtn" Content="Продолжить историю" Margin="0,20,0,0" Height="50" FontSize="18" Visibility="Collapsed" Click="ContinueStoryBtn_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Pause Menu Overlay -->
        <Border Name="PauseOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <TextBlock Text="ПАУЗА" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="Продолжить" Margin="0,10" Height="40" FontSize="18" Click="ResumeBtn_Click"/>
                <Button Name="PauseSaveBtn" Content="Сохранить игру" Margin="0,10" Height="40" FontSize="18" Click="SaveBtn_Click"/>
                <Button Content="Главное меню" Margin="0,10" Height="40" FontSize="18" Click="MainMenuBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
