<UserControl x:Class="EpicBattle.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpicBattle.Views"
             xmlns:vm="clr-namespace:EpicBattle.ViewModels"
             Background="#1a1a1a"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <Grid Name="MainGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Волна и Пауза -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding WaveText}" Foreground="#FFAA00" FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Text="ESC - Пауза" Foreground="Gray" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Игрок -->
            <StackPanel Grid.Column="0" Name="PlayerColumnHost">
                <!-- Этап 3.3: вспышка при получении удара (импульс из VM) -->
                <Border Background="#44FF3333" CornerRadius="6" Opacity="0" Height="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlayerHitPulse}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:0.45"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding Player.Name}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>

                <!-- HP -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="HP: " Foreground="#FF5555" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.Hp}" Foreground="#FF5555" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#FF5555" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.MaxHp}" Foreground="#FF5555" FontWeight="Bold"/>
                </StackPanel>
                <ProgressBar Value="{Binding Player.Hp}" Maximum="{Binding Player.MaxHp}" Height="15" Foreground="#FF5555" Background="#333333" BorderThickness="0" Margin="0,0,0,5"/>

                <!-- MP -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MP: " Foreground="#5555FF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.Mp}" Foreground="#5555FF" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#5555FF" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.MaxMp}" Foreground="#5555FF" FontWeight="Bold"/>
                </StackPanel>
                <ProgressBar Value="{Binding Player.Mp}" Maximum="{Binding Player.MaxMp}" Height="10" Foreground="#5555FF" Background="#333333" BorderThickness="0" Margin="0,0,0,5"/>

                <!-- AP и зелья -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="AP: " Foreground="#FFFF55" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.CurrentAP}" Foreground="#FFFF55" FontWeight="Bold"/>
                    <TextBlock Text=" / " Foreground="#FFFF55" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Player.MaxAP}" Foreground="#FFFF55" FontWeight="Bold" Margin="0,0,15,0"/>

                    <TextBlock Text="🧪 HP: " Foreground="#AAFFAA"/>
                    <TextBlock Text="{Binding Player.HpPotions}" Foreground="#AAFFAA" Margin="0,0,15,0"/>

                    <TextBlock Text="💧 MP: " Foreground="#AAAAFF"/>
                    <TextBlock Text="{Binding Player.MpPotions}" Foreground="#AAAAFF"/>
                </StackPanel>

                <!-- Статусы игрока -->
                <ItemsControl ItemsSource="{Binding Player.ActiveEffects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,5,0">
                                <TextBlock Text="{Binding IconPath}" FontSize="16" ToolTip="{Binding Name}"/>
                                <Border Background="#AA000000" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="2,0">
                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="VS" Foreground="Gray" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Враги (Список) -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding Enemies}" Name="EnemiesHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="EnemyBorder" BorderBrush="#333333" BorderThickness="2" Margin="0,0,0,10" Padding="10" Background="#222" CornerRadius="6">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Path=DataContext.SelectTargetCommand}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка намерения -->
                                    <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" ToolTip="{Binding CurrentIntent.Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CurrentIntent.IconPath}" FontFamily="Segoe UI Emoji, Segoe UI Symbol" Foreground="#FFAA00" FontSize="15" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding CurrentIntent.Description}" Foreground="#AAAAAA" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Имя врага -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,3">
                                    <TextBlock Text="HP: " Foreground="#FF5555" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Hp}" Foreground="#FF5555" FontWeight="Bold"/>
                                    <TextBlock Text=" / " Foreground="#FF5555" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MaxHp}" Foreground="#FF5555" FontWeight="Bold"/>
                                </StackPanel>
                                
                                <ProgressBar Value="{Binding Hp}" Maximum="{Binding MaxHp}" Height="15" HorizontalAlignment="Stretch" Foreground="#FF5555" Background="#333333" BorderThickness="0" Margin="0,0,0,6">
                                    <ProgressBar.LayoutTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </ProgressBar.LayoutTransform>
                                </ProgressBar>

                                <!-- Статусы врага -->
                                <ItemsControl ItemsSource="{Binding ActiveEffects}" HorizontalAlignment="Right">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,5,0">
                                                <TextBlock Text="{Binding IconPath}" FontSize="16" ToolTip="{Binding Name}"/>
                                                <Border Background="#AA000000" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Padding="2,0">
                                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTargeted}" Value="True">
                                <Setter TargetName="EnemyBorder" Property="BorderBrush" Value="#FF5555" />
                                <Setter TargetName="EnemyBorder" Property="Background" Value="#332222" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Лог Боя -->
        <Border Grid.Row="2" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Name="LogScroller">
                <ItemsControl ItemsSource="{Binding CombatLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextColor, FallbackValue='#E0E0E0'}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Статус боя -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#FFAA00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Панель действий -->
        <StackPanel Grid.Row="4" Orientation="Vertical">
            <!-- Активные навыки игрока -->
            <ItemsControl ItemsSource="{Binding PlayerSkills}" HorizontalAlignment="Center" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="5,0" Padding="10,5"
                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Path=DataContext.UseSkillCommand}"
                                CommandParameter="{Binding}"
                                Background="#334466">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconPath}" FontSize="15" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ManaCost, StringFormat='{} • {0} 💧'}" Foreground="#55AAFF" Margin="4,0,0,0" ToolTip="{Binding APCost, StringFormat='Расход очков действий: {0} ОД'}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Основные кнопки действий -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="⚔️ Удар" ToolTip="Атака оружием (2 ОД)" Margin="5,0" Width="130" Height="40" Command="{Binding AttackCommand}"/>
                <Button Content="🛡️ Защита" ToolTip="Снижение получаемого урона (2 ОД)" Margin="5,0" Width="130" Height="40" Command="{Binding DefendCommand}"/>
                <Button Content="🧪 Зелье HP" ToolTip="Восстановить здоровье (1 ОД)" Margin="5,0" Width="130" Height="40" Command="{Binding UsePotionHpCommand}"/>
                <Button Content="💧 Зелье MP" ToolTip="Восстановить ману (1 ОД)" Margin="5,0" Width="130" Height="40" Command="{Binding UsePotionMpCommand}"/>
                <Button Content="⌛ Завершить ход" Margin="5,0" Width="130" Height="40" Background="#553333" Command="{Binding EndTurnCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Оверлей прокачки после победы -->
        <Border Name="UpgradeOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC000000" Panel.ZIndex="50">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpgradeOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" BorderBrush="#FFAA00" BorderThickness="2" CornerRadius="8" Width="620" Padding="25">
                <StackPanel>
                    <TextBlock Text="🏆 ПОБЕДА! УРОВЕНЬ ПОВЫШЕН!" Foreground="#FFAA00" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Распределите характеристики и изучите новые навыки:" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Сводка очков -->
                    <Border Background="#181818" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Уровень: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlayerLevel}" Foreground="#FFAA00" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Очки характеристик: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatPoints}" Foreground="#55FF55" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Очки навыков: " Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SkillPoints}" Foreground="#55AAFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Сводка добычи (Лут и Золото) -->
                    <Border Background="#1A2A1A" BorderBrush="#2E6B30" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="🎁 НАЙДЕННЫЕ ТРОФЕИ:" Foreground="#FFAA00" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LootSummaryText}" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding DroppedLoot}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#242424" BorderBrush="{Binding RarityColor}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconPath}" FontSize="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding RarityColor}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding FormattedStats, StringFormat=' ({0})'}" Foreground="LightGray" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки распределения статов -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Сила -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сила" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Strength, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding PlayerBaseDamage, StringFormat='Физ. урон: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="STR"/>
                            </Grid>
                        </Border>

                        <!-- Ловкость -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ловкость" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Dexterity, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding CritChance, StringFormat='Крит / Уклон: {0:F0}%'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="DEX"/>
                            </Grid>
                        </Border>

                        <!-- Интеллект -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Интеллект" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Intelligence, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding PlayerBaseMagicDamage, StringFormat='Маг. урон: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="INT"/>
                            </Grid>
                        </Border>

                        <!-- Выносливость -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#282828" CornerRadius="5" Padding="10" Margin="5">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Выносливость" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Endurance, StringFormat='Значение: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding Defense, StringFormat='Защита: {0}'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                                <Button Content="+" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        FontSize="18" FontWeight="Bold" Background="#2E6B30" Command="{Binding IncreaseStatCommand}" CommandParameter="END"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Кнопка перехода к дереву навыков -->
                    <Button Content="🌳 Изучить навыки в Древе Талантов" Margin="5,0,5,10" Height="38" FontSize="14" Background="#334466" Command="{Binding OpenSkillTreeCommand}"/>
                    <Button Content="🎒 Осмотреть инвентарь и надеть лут" Margin="5,0,5,10" Height="38" FontSize="14" Background="#4A3A2E" Command="{Binding OpenInventoryCommand}"/>

                    <!-- Кнопки продолжения в зависимости от режима -->
                    <Button Content="➡️ Продолжить (Сюжет)" Margin="0,10,0,0" Height="45" FontSize="16" Background="#28a745" Command="{Binding ContinueStoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStoryMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🗺️ Вернуться на Карту Похода" Margin="0,10,0,0" Height="45" FontSize="16" FontWeight="Bold" Background="#2E6B30" Command="{Binding ReturnToMapCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMapMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="⚔️ Следующий бой (Аркада)" Margin="0,10,0,0" Height="45" FontSize="16" Background="#28a745" Command="{Binding NextBattleCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArcadeMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- P0-фикс (Б1): экран поражения. Раньше IsPlayerDead не был привязан ни к одному элементу UI,
             и после смерти игрока все кнопки блокировались без возможности выхода из боя. -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#E6000000" Panel.ZIndex="200">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayerDead}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2A1515" BorderBrush="#8B0000" BorderThickness="2" CornerRadius="8" Width="360" Padding="24">
                <StackPanel>
                    <TextBlock Text="💀 ПОРАЖЕНИЕ" Foreground="#FF4444" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Ваш герой пал в бою. Прогресс сохранён на последнем контрольном пункте." Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Вернуться в главное меню" Command="{Binding ReturnToMenuCommand}" Height="40" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Меню Паузы -->
        <Border Name="PauseOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Width="300" Padding="20">
                <StackPanel>
                    <TextBlock Text="ПАУЗА" Foreground="#FFAA00" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Продолжить" Margin="0,5" Height="35" Click="ResumeBtn_Click"/>
                    <Button Content="Главное меню" Margin="0,5" Height="35" Click="MainMenuBtn_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
