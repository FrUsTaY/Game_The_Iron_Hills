<UserControl x:Class="EpicBattle.Views.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0D0C"
             Focusable="True"
             Loaded="UserControl_Loaded"
             KeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <!-- Базовый фэнтезийный стиль кнопки меню (кованое железо / темный сланец) -->
        <Style x:Key="RpgMenuButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#282420" Offset="0.0"/>
                        <GradientStop Color="#191715" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E2D7C5"/>
            <Setter Property="BorderBrush" Value="#4A3F33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#D4A359"/>
                                <Setter Property="Foreground" Value="#FFF8EC"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#383129" Offset="0.0"/>
                                            <GradientStop Color="#221D18" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#B8863A"/>
                                <Setter TargetName="border" Property="Background" Value="#13110F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Акцентная главная кнопка меню (золотая окантовка и рунное свечение) -->
        <Style x:Key="RpgPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RpgMenuButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3A2E1A" Offset="0.0"/>
                        <GradientStop Color="#20170A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#C99738"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FFD97D"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#FFAA00" Opacity="0.25" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD566"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4C3A1F" Offset="0.0"/>
                                            <GradientStop Color="#2C1F0E" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" Color="#FFBB22" Opacity="0.45" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AA771E"/>
                                <Setter TargetName="border" Property="Background" Value="#171107"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль двухстрочной кнопки для выбора режима игры -->
        <Style x:Key="RpgModeCardButtonStyle" TargetType="Button" BasedOn="{StaticResource RpgMenuButtonStyle}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>

        <!-- Вторичная кнопка (Назад / Выход) -->
        <Style x:Key="RpgSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RpgMenuButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#221F1E" Offset="0.0"/>
                        <GradientStop Color="#151313" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38302A"/>
            <Setter Property="Foreground" Value="#AFA599"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.90"/>
        <Border Background="#350E0D10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Центральная каменная плита меню -->
                <Border Background="#E5141317" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Margin="0,20" Padding="26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.85" ShadowDepth="4"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center" Width="370">
                        <!-- Металлический логотип игры -->
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,0,18" HorizontalAlignment="Center">
                            <Image Name="LogoImage" Stretch="Uniform" MaxHeight="190" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Name="TitleText" Text="⚔️ ЖЕЛЕЗНЫЙ КРЯЖ ⚔️" Foreground="#FFAA00" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <!-- ========================================== -->
                        <!-- ЭКРАН 1: ГЛАВНОЕ МЕНЮ                     -->
                        <!-- ========================================== -->
                        <StackPanel Name="MainButtonsPanel" Visibility="Visible">
                            <!-- Акцентная кнопка «Играть» -->
                            <Button Style="{StaticResource RpgPrimaryButtonStyle}" Click="PlayBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚔️" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="И Г Р А Т Ь" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Загрузка сохранения -->
                            <Button Style="{StaticResource RpgMenuButtonStyle}" Click="LoadBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Загрузить игру" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Бестиарий и лор -->
                            <Button Style="{StaticResource RpgMenuButtonStyle}" Click="BestiaryBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Бестиарий и Хроники" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Настройки игры -->
                            <Button Style="{StaticResource RpgMenuButtonStyle}" Click="SettingsBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Разделитель перед выходом -->
                            <Rectangle Height="1" Fill="#332B22" Margin="30,8,30,8"/>

                            <!-- Выход -->
                            <Button Style="{StaticResource RpgSecondaryButtonStyle}" Click="ExitBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚪" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Выход из игры" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ========================================== -->
                        <!-- ЭКРАН 2: ВЫБОР РЕЖИМА ИГРЫ                 -->
                        <!-- ========================================== -->
                        <StackPanel Name="ModesPanel" Visibility="Collapsed">
                            <!-- Заголовок выбора режима -->
                            <Border BorderBrush="#3D3225" BorderThickness="0,0,0,1" Margin="0,0,0,12" Padding="0,0,0,8">
                                <TextBlock Text="— ВЫБОР РЕЖИМА —" Foreground="#D4A359" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Сюжетная кампания -->
                            <Button Style="{StaticResource RpgModeCardButtonStyle}" Click="StoryBtn_Click">
                                <Grid Width="340">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚔️" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Сюжетная кампания" FontSize="14" FontWeight="Bold" Foreground="#FFF0D2"/>
                                        <TextBlock Text="Новая игра • Судьба Железного Кряжа" FontSize="11" Foreground="#958A7A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Выбор главы -->
                            <Button Style="{StaticResource RpgModeCardButtonStyle}" Click="ChapterSelectBtn_Click">
                                <Grid Width="340">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📜" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Выбор Главы" FontSize="14" FontWeight="Bold" Foreground="#FFF0D2"/>
                                        <TextBlock Text="Перепрохождение завершённых глав сюжета" FontSize="11" Foreground="#958A7A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Поход по Кряжу -->
                            <Button Style="{StaticResource RpgModeCardButtonStyle}" Click="MapModeBtn_Click">
                                <Grid Width="340">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🗺️" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Поход по Кряжу" FontSize="14" FontWeight="Bold" Foreground="#FFF0D2"/>
                                        <TextBlock Text="Карта узлов • Пошаговые события и лагеря" FontSize="11" Foreground="#958A7A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Аркада -->
                            <Button Style="{StaticResource RpgModeCardButtonStyle}" Click="ArcadeBtn_Click">
                                <Grid Width="340">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏆" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Аркада" FontSize="14" FontWeight="Bold" Foreground="#FFF0D2"/>
                                        <TextBlock Text="Бесконечные битвы • Волны чудовищ" FontSize="11" Foreground="#958A7A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Отступ перед возвратом -->
                            <Rectangle Height="1" Fill="#332B22" Margin="30,8,30,8"/>

                            <!-- Кнопка «Назад в меню» -->
                            <Button Style="{StaticResource RpgSecondaryButtonStyle}" Click="BackBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↩" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Назад в меню" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>