<UserControl x:Class="EpicBattle.Views.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a1a">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="ЖЕЛЕЗНЫЙ КРЯЖ" Foreground="#FFAA00" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,50"/>

            <Button Content="Режим Истории" Margin="0,10" Height="40" FontSize="18" Click="StoryBtn_Click"/>
            <Button Content="Аркада (Бесконечная игра)" Margin="0,10" Height="40" FontSize="18" Click="ArcadeBtn_Click"/>
            <Button Content="Загрузить игру" Margin="0,10" Height="40" FontSize="18" Click="LoadBtn_Click"/>
            <Button Content="Настройки" Margin="0,10" Height="40" FontSize="18" Click="SettingsBtn_Click"/>
            <Button Content="Выход" Margin="0,10" Height="40" FontSize="18" Click="ExitBtn_Click"/>
        </StackPanel>
    </Grid>
</UserControl>