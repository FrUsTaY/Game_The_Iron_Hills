<UserControl x:Class="EpicBattle.Views.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a1a">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Margin="0,25">
                <TextBlock Text="⚔️ ЖЕЛЕЗНЫЙ КРЯЖ ⚔️" Foreground="#FFAA00" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Эпическая пошаговая RPG (v3.1)" Foreground="Gray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Button Content="▶️ Новая игра (Сюжет)" Margin="0,4" Height="40" FontSize="15" FontWeight="Bold" Background="#2E6B30" Click="StoryBtn_Click"/>
                <Button Content="📜 Выбор Главы (Акта)" Margin="0,4" Height="40" FontSize="15" FontWeight="Bold" Background="#443366" Click="ChapterSelectBtn_Click"/>
                <Button Content="🗺️ Поход по Кряжу (Карта узлов)" Margin="0,4" Height="40" FontSize="15" FontWeight="Bold" Background="#205060" Click="MapModeBtn_Click"/>
                <Button Content="🏆 Аркада (Бесконечная битва)" Margin="0,4" Height="40" FontSize="15" Background="#3A3A4A" Click="ArcadeBtn_Click"/>
                <Button Content="🎒 Инвентарь и Персонаж" Margin="0,4" Height="40" FontSize="15" Click="InventoryBtn_Click"/>
                <Button Content="💾 Загрузить игру" Margin="0,4" Height="40" FontSize="15" Click="LoadBtn_Click"/>
                <Button Content="⚙️ Настройки" Margin="0,4" Height="40" FontSize="15" Click="SettingsBtn_Click"/>
                <Button Content="🚪 Выход" Margin="0,4" Height="40" FontSize="15" Background="#442222" Click="ExitBtn_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
