<UserControl x:Class="EpicBattle.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0D10" Foreground="#E2D7C5">

    <UserControl.Resources>
        <!-- Базовый фэнтезийный стиль кнопки меню -->
        <Style x:Key="RpgMenuButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#282420" Offset="0.0"/>
                        <GradientStop Color="#191715" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E2D7C5"/>
            <Setter Property="BorderBrush" Value="#4A3F33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#D4A359"/>
                                <Setter Property="Foreground" Value="#FFF8EC"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#383129" Offset="0.0"/>
                                            <GradientStop Color="#221D18" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#B8863A"/>
                                <Setter TargetName="border" Property="Background" Value="#13110F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вторичная кнопка (Назад) -->
        <Style x:Key="RpgSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RpgMenuButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#221F1E" Offset="0.0"/>
                        <GradientStop Color="#151313" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38302A"/>
            <Setter Property="Foreground" Value="#AFA599"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль ползунка (Slider) в духе темного фэнтези -->
        <Style x:Key="RpgSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#C89B3C" BorderBrush="#FFF0C0" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#FFAA00" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RpgSlider" TargetType="{x:Type Slider}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C89B3C"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#141210" BorderBrush="#3D3225" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource RpgSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение главного меню / настроек -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.90"/>
        <Border Background="#350E0D10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <!-- Центральная каменная плита меню настроек -->
                <Border Background="#E5141317" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Padding="26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.85" ShadowDepth="4"/>
                    </Border.Effect>

                    <StackPanel Width="380">
                        <!-- Заголовок -->
                        <Border BorderBrush="#3D3225" BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,10">
                            <TextBlock Text="— НАСТРОЙКИ ИГРЫ —" Foreground="#FFAA00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- БЛОК: ЗВУК И МУЗЫКА -->
                        <Border Background="#1C1917" BorderBrush="#3D352B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🎵 ЗВУК И МУЗЫКА" Foreground="#D4A359" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Громкость музыки -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость музыки" Foreground="#DDD4C5" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Name="MusicPercentText" Grid.Column="1" Text="30%" Foreground="#FFAA00" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Name="MusicSlider" Style="{StaticResource RpgSlider}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,12" ValueChanged="MusicSlider_ValueChanged"/>

                                <!-- Громкость звуков -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость эффектов (SFX)" Foreground="#DDD4C5" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Name="SfxPercentText" Grid.Column="1" Text="80%" Foreground="#FFAA00" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Name="SfxSlider" Style="{StaticResource RpgSlider}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SfxSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- БЛОК: ДИСПЛЕЙ И ЭКРАН -->
                        <Border Background="#1C1917" BorderBrush="#3D352B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🖥️ ДИСПЛЕЙ И РАЗРЕШЕНИЕ" Foreground="#D4A359" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Режим экрана -->
                                <TextBlock Text="Режим экрана:" Foreground="#958A7A" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox Name="DisplayModeCombo" Margin="0,0,0,12" Height="36" FontSize="13"
                                          Background="#151311" Foreground="White" BorderBrush="#4A3F33">
                                    <ComboBoxItem Content="В окне"/>
                                    <ComboBoxItem Content="В окне без рамки"/>
                                    <ComboBoxItem Content="Во весь экран"/>
                                </ComboBox>

                                <!-- Разрешение экрана -->
                                <TextBlock Text="Разрешение экрана:" Foreground="#958A7A" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox Name="ResolutionCombo" Margin="0,0,0,14" Height="36" FontSize="13"
                                          Background="#151311" Foreground="White" BorderBrush="#4A3F33">
                                    <ComboBoxItem Content="1280x720"/>
                                    <ComboBoxItem Content="1366x768"/>
                                    <ComboBoxItem Content="1600x900"/>
                                    <ComboBoxItem Content="1920x1080"/>
                                    <ComboBoxItem Content="2560x1440"/>
                                </ComboBox>

                                <Button Style="{StaticResource RpgMenuButtonStyle}" Height="38" FontSize="13" Click="ApplyDisplayBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖥️" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Применить параметры экрана" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Разделитель перед выходом -->
                        <Rectangle Height="1" Fill="#332B22" Margin="30,0,30,12"/>

                        <!-- Кнопка возврата -->
                        <Button Style="{StaticResource RpgSecondaryButtonStyle}" Click="BackBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Сохранить и выйти в меню" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
