<UserControl x:Class="EpicBattle.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0D10" Foreground="White">
    <Grid>
        <!-- Фоновое изображение главного меню / настроек -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
        <Border Background="#350E0D10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Border Background="#DD15141A" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Padding="30">
                    <StackPanel>
                        <!-- Заголовок -->
                        <TextBlock Text="⚙️ НАСТРОЙКИ ИГРЫ" Foreground="#FFAA00" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <!-- БЛОК: ЗВУК -->
                        <Border Background="#221E28" BorderBrush="#443850" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🎵 ЗВУК И МУЗЫКА" Foreground="#CC88FF" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Громкость музыки -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость музыки" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Name="MusicPercentText" Grid.Column="1" Text="30%" Foreground="#FFAA00" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Name="MusicSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,15" ValueChanged="MusicSlider_ValueChanged"/>

                                <!-- Громкость звуков -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость эффектов (SFX)" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Name="SfxPercentText" Grid.Column="1" Text="80%" Foreground="#FFAA00" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Name="SfxSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SfxSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- БЛОК: ДИСПЛЕЙ И ЭКРАН -->
                        <Border Background="#221E28" BorderBrush="#443850" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Text="🖥️ ДИСПЛЕЙ И РАЗРЕШЕНИЕ" Foreground="#77AAFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                                <!-- Режим экрана -->
                                <TextBlock Text="Режим экрана:" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,6"/>
                                <ComboBox Name="DisplayModeCombo" Margin="0,0,0,14" Height="38" FontSize="14">
                                    <ComboBoxItem Content="В окне"/>
                                    <ComboBoxItem Content="В окне без рамки"/>
                                    <ComboBoxItem Content="Во весь экран"/>
                                </ComboBox>

                                <!-- Разрешение экрана -->
                                <TextBlock Text="Разрешение экрана:" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,6"/>
                                <ComboBox Name="ResolutionCombo" Margin="0,0,0,16" Height="38" FontSize="14">
                                    <ComboBoxItem Content="1280x720"/>
                                    <ComboBoxItem Content="1366x768"/>
                                    <ComboBoxItem Content="1600x900"/>
                                    <ComboBoxItem Content="1920x1080"/>
                                    <ComboBoxItem Content="2560x1440"/>
                                </ComboBox>

                                <Button Content="🖥️ Применить параметры экрана" Height="40" FontSize="14" FontWeight="Bold" Background="#23354C" BorderBrush="#4A6E9E" BorderThickness="1.5" Click="ApplyDisplayBtn_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопка возврата -->
                        <Button Content="⬅️ Сохранить и выйти в меню" Height="44" FontSize="16" FontWeight="Bold" Background="#3A3028" BorderBrush="#8A6030" BorderThickness="1.5" Click="BackBtn_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
