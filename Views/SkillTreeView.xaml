<UserControl x:Class="EpicBattle.Views.SkillTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E6000000"
             Foreground="White">
    <UserControl.Resources>
        <local:BoolToColorConverter xmlns:local="clr-namespace:EpicBattle.ViewModels" x:Key="BoolToColorConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="ДЕРЕВО НАВЫКОВ" FontSize="28" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding SkillPoints, StringFormat='Очки навыков: {0}'}" FontSize="18" Foreground="LightGreen" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

            <!-- Путь Меча -->
            <Border Grid.Column="0" BorderBrush="#555" BorderThickness="1" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Путь Меча" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding SwordPathSkills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding IsLearned, Converter={StaticResource BoolToColorConverter}}" BorderThickness="2" Margin="0,5" Padding="5" Background="#222">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{Binding IsLearned, Converter={StaticResource BoolToColorConverter}}"/>
                                        <TextBlock Text="{Binding Type}" FontSize="12" Foreground="LightGray"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" Margin="0,5"/>
                                        <TextBlock Text="{Binding Requirements}" FontSize="12" Foreground="DarkGray" Margin="0,0,0,5"/>
                                        <Button Content="Изучить" Command="{Binding LearnCommand}" IsEnabled="{Binding CanLearn}" Padding="5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Тайные Искусства -->
            <Border Grid.Column="1" BorderBrush="#555" BorderThickness="1" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Тайные Искусства" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ArcaneArtsSkills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding IsLearned, Converter={StaticResource BoolToColorConverter}}" BorderThickness="2" Margin="0,5" Padding="5" Background="#222">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{Binding IsLearned, Converter={StaticResource BoolToColorConverter}}"/>
                                        <TextBlock Text="{Binding Type}" FontSize="12" Foreground="LightGray"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" Margin="0,5"/>
                                        <TextBlock Text="{Binding Requirements}" FontSize="12" Foreground="DarkGray" Margin="0,0,0,5"/>
                                        <Button Content="Изучить" Command="{Binding LearnCommand}" IsEnabled="{Binding CanLearn}" Padding="5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Выживание -->
            <Border Grid.Column="2" BorderBrush="#555" BorderThickness="1" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Выживание" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding SurvivalSkills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding IsLearned, Converter={StaticResource BoolToColorConverter}}" BorderThickness="2" Margin="0,5" Padding="5" Background="#222">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{Binding IsLearned, Converter={StaticResource BoolToColorConverter}}"/>
                                        <TextBlock Text="{Binding Type}" FontSize="12" Foreground="LightGray"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" Margin="0,5"/>
                                        <TextBlock Text="{Binding Requirements}" FontSize="12" Foreground="DarkGray" Margin="0,0,0,5"/>
                                        <Button Content="Изучить" Command="{Binding LearnCommand}" IsEnabled="{Binding CanLearn}" Padding="5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" Command="{Binding CloseCommand}" Width="150" Height="40" FontSize="16" Margin="0,20,0,0"/>
    </Grid>
</UserControl>
