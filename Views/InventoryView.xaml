<UserControl x:Class="EpicBattle.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181818" Foreground="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
        <Border Background="#35181818"/>
        <Grid Margin="15" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: заголовок, персонаж и золото -->
        <Border Grid.Row="0" Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="🎒 ИНВЕНТАРЬ И ЭКИПИРОВКА" FontSize="18" FontWeight="Bold" Foreground="#FFAA00"/>
                    <TextBlock Text=" | " Foreground="Gray" FontSize="16" Margin="8,0"/>
                    <TextBlock Text="{Binding PlayerName}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" (" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PlayerClass}" Foreground="LightGray" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text=", Ур. " Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PlayerLevel}" Foreground="#55FF55" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=")" Foreground="Gray" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="💰 Золото: " FontSize="15" FontWeight="Bold" Foreground="#FFDD44"/>
                    <TextBlock Text="{Binding Gold}" FontSize="15" FontWeight="Bold" Foreground="#FFDD44"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3 Колонки: Снаряжение и статы (320) | Рюкзак (*) | Карточка предмета (330) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Слоты и параметры -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="СНАРЯЖЕНИЕ" FontSize="13" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,6" HorizontalAlignment="Center"/>

                        <Button Margin="0,1" Height="36" HorizontalContentAlignment="Left" Padding="8,0" Click="SlotBtn_Click" Tag="Weapon" Background="#282828">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EquippedWeaponIcon, StringFormat='{}{0} '}" FontSize="12"/>
                                <TextBlock Text="{Binding EquippedWeaponName}" Foreground="{Binding EquippedWeaponBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,1" Height="36" HorizontalContentAlignment="Left" Padding="8,0" Click="SlotBtn_Click" Tag="Helmet" Background="#282828">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EquippedHelmetIcon, StringFormat='{}{0} '}" FontSize="12"/>
                                <TextBlock Text="{Binding EquippedHelmetName}" Foreground="{Binding EquippedHelmetBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,1" Height="36" HorizontalContentAlignment="Left" Padding="8,0" Click="SlotBtn_Click" Tag="Chest" Background="#282828">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EquippedChestIcon, StringFormat='{}{0} '}" FontSize="12"/>
                                <TextBlock Text="{Binding EquippedChestName}" Foreground="{Binding EquippedChestBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,1" Height="36" HorizontalContentAlignment="Left" Padding="8,0" Click="SlotBtn_Click" Tag="Boots" Background="#282828">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EquippedBootsIcon, StringFormat='{}{0} '}" FontSize="12"/>
                                <TextBlock Text="{Binding EquippedBootsName}" Foreground="{Binding EquippedBootsBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,1" Height="36" HorizontalContentAlignment="Left" Padding="8,0" Click="SlotBtn_Click" Tag="Ring" Background="#282828">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EquippedRingIcon, StringFormat='{}{0} '}" FontSize="12"/>
                                <TextBlock Text="{Binding EquippedRingName}" Foreground="{Binding EquippedRingBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,1" Height="36" HorizontalContentAlignment="Left" Padding="8,0" Click="SlotBtn_Click" Tag="Amulet" Background="#282828">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EquippedAmuletIcon, StringFormat='{}{0} '}" FontSize="12"/>
                                <TextBlock Text="{Binding EquippedAmuletName}" Foreground="{Binding EquippedAmuletBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,6" Background="#333333"/>
                        <TextBlock Text="ХАРАКТЕРИСТИКИ" FontSize="13" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,4" HorizontalAlignment="Center"/>

                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Здоровье / Мана:" Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedHpMp}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Grid>

                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Урон:" Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedDamage}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Grid>

                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Броня:" Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding Armor}" Foreground="#FFAA00" FontSize="12" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Крит / Уклон:" Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedCritDodge}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Grid>

                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Сила / Ловкость:" Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedStrDex}" FontSize="12" FontWeight="Bold" Foreground="LightGreen"/>
                        </Grid>

                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Интеллект / Выносливость:" Foreground="Gray" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding FormattedIntEnd}" FontSize="12" FontWeight="Bold" Foreground="LightBlue"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Центральная колонка: Рюкзак -->
            <Border Grid.Column="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="РЮКЗАК (ПРЕДМЕТЫ)" FontSize="13" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,6" HorizontalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding InventoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,2" Padding="6,4" Background="#282828" BorderBrush="{Binding RarityBrush}" BorderThickness="1"
                                            HorizontalContentAlignment="Stretch"
                                            Click="ItemBtn_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding IconPath}" FontSize="14" VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="1" Margin="4,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding RarityBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Left"/>
                                                <TextBlock Text="{Binding FormattedStats}" Foreground="LightGray" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SlotDisplayName}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Правая колонка: Инспектор выбранного предмета -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="8">
                <Grid>
                    <!-- Заглушка, если ничего не выбрано -->
                    <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}">
                        <TextBlock Text="Нажмите на предмет в рюкзаке или слот экипировки слева для просмотра параметров." Foreground="Gray" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>

                    <!-- Карточка предмета -->
                    <StackPanel Visibility="{Binding DetailsVisibility}">
                        <TextBlock Text="ИНФОРМАЦИЯ" FontSize="13" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,6" HorizontalAlignment="Center"/>

                        <Border Background="#252525" BorderBrush="{Binding SelectedItemBrush}" BorderThickness="1.5" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedItemName}" Foreground="{Binding SelectedItemBrush}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding SelectedItemRarityName}" Foreground="{Binding SelectedItemBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text=" • " Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItemSlotName}" Foreground="LightGray" FontSize="11"/>
                                </StackPanel>

                                <Separator Background="#444" Margin="0,3"/>
                                
                                <TextBlock Text="{Binding SelectedItemStats}" Foreground="#55FF55" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3"/>
                                <TextBlock Text="{Binding SelectedItemDesc}" Foreground="LightGray" FontSize="11" TextWrapping="Wrap" Margin="0,3"/>

                                <Separator Background="#444" Margin="0,3"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: " Foreground="Gray" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItemGold}" Foreground="#FFDD44" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text=" 💰" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="🛡️ Надеть" Height="34" FontSize="13" FontWeight="Bold" Background="#28a745" Click="EquipBtn_Click" Margin="0,3" IsEnabled="{Binding CanEquipSelected}"/>
                        <Button Content="📦 Снять" Height="34" FontSize="13" FontWeight="Bold" Background="#aa5500" Click="UnequipBtn_Click" Margin="0,3" IsEnabled="{Binding CanUnequipSelected}"/>
                        <!-- P2 (П4): применение расходников из инвентаря -->
                        <Button Content="{Binding UseButtonText}" Height="34" FontSize="13" FontWeight="Bold" Background="#6a1b9a" Click="UseBtn_Click" Margin="0,3" IsEnabled="{Binding CanUseSelected}"
                                Visibility="{Binding CanUseSelected, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель закрытия -->
        <Button Grid.Row="2" Content="⬅️ Закрыть инвентарь" Height="44" FontSize="15" FontWeight="Bold" Background="#3a3a3a" Click="CloseBtn_Click"/>
        </Grid>
    </Grid>
</UserControl>
