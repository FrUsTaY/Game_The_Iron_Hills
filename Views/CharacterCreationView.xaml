<UserControl x:Class="EpicBattle.Views.CharacterCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpicBattle.ViewModels"
             Background="#100E0D"
             Foreground="White">
    <UserControl.Resources>
        <local:ClassToColorConverter x:Key="ClassToColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <!-- Фоновое изображение арсенала -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
        <Border Background="#35100E14"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1160">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок экрана -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="⚔️ СОЗДАНИЕ ГЕРОЯ ⚔️" FontSize="26" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center"/>
                    <TextBlock Text="Выберите боевой путь и распределите начальные характеристики" FontSize="13" Foreground="#BBBBBB" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Основная 3-колоночная композиция -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="370"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ КОЛОНКА: Имя, выбор класса и описание -->
                    <Border Grid.Column="0" Background="#DD17151D" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                        <StackPanel>
                            <!-- Имя героя -->
                            <TextBlock Text="🏷️ Имя Героя:" FontSize="15" FontWeight="Bold" Foreground="#FFCC66" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold" Padding="8,6" Margin="0,0,0,16"
                                     Background="#262330" Foreground="White" BorderBrush="#665544" BorderThickness="1.5"/>

                            <!-- Выбор класса -->
                            <TextBlock Text="⚔️ Боевой класс:" FontSize="15" FontWeight="Bold" Foreground="#FFCC66" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,16">
                                <Button Content="🛡️ Ветеран" Command="{Binding SelectClassCommand}" CommandParameter="Ветеран"
                                        Height="38" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="14,0"
                                        Background="{Binding SelectedClass, Converter={StaticResource ResourceKey=ClassToColorConverter}, ConverterParameter=Ветеран}"/>
                                <Button Content="🔮 Изгой-маг" Command="{Binding SelectClassCommand}" CommandParameter="Изгой-маг"
                                        Height="38" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" HorizontalContentAlignment="Left" Padding="14,0"
                                        Background="{Binding SelectedClass, Converter={StaticResource ResourceKey=ClassToColorConverter}, ConverterParameter=Изгой-маг}"/>
                                <Button Content="🗡️ Наемник" Command="{Binding SelectClassCommand}" CommandParameter="Наемник"
                                        Height="38" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Left" Padding="14,0"
                                        Background="{Binding SelectedClass, Converter={StaticResource ResourceKey=ClassToColorConverter}, ConverterParameter=Наемник}"/>
                            </StackPanel>

                            <!-- Описание класса и особенности -->
                            <Border Background="#201C26" BorderBrush="#443850" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="📖 Особенности класса:" FontSize="14" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding ClassDescription}" TextWrapping="Wrap" FontSize="13" Foreground="#DDDDDD" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ЦЕНТРАЛЬНАЯ КОЛОНКА: ВЕЛИЧЕСТВЕННЫЙ АРТ ГЕРОЯ -->
                    <Border Grid.Column="1" Background="#DD17151D" BorderBrush="#6E5535" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Рамка с большим портретом персонажа (330x440) -->
                            <Border Grid.Row="0" CornerRadius="8" BorderBrush="#AA8850" BorderThickness="2" ClipToBounds="True" Background="#0C0A10">
                                <Grid>
                                    <Image Source="{Binding HeroPortrait}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- Мягкая виньетка по краям арта -->
                                    <Border>
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
                                                <GradientStop Color="#00000000" Offset="0.6"/>
                                                <GradientStop Color="#70000000" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Бейдж класса под артом -->
                            <Border Grid.Row="1" Background="#261E14" BorderBrush="#8A6635" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="{Binding ClassTitleBadge}" Foreground="#FFCC66" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ПРАВАЯ КОЛОНКА: Характеристики и распределение очков -->
                    <Border Grid.Column="2" Background="#DD17151D" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <!-- Счетчик очков -->
                            <Border Background="#282012" BorderBrush="#AA7700" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="⭐ Очки характеристик:" FontSize="14" FontWeight="Bold" Foreground="#DDD" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AvailablePoints, StringFormat='Доступно: {0}'}" FontSize="15" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Строка: СИЛА -->
                            <Border Background="#221E28" BorderBrush="#3D3548" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="💪 Сила" FontSize="15" FontWeight="Bold" Foreground="#FF9966"/>
                                        <TextBlock Text="+2 физ. урон за очко" FontSize="10" Foreground="#888"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="-" Height="34" FontSize="18" FontWeight="Bold" Background="#332A38" Command="{Binding DecreaseStatCommand}" CommandParameter="STR"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Strength}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                    <Button Grid.Column="3" Content="+" Height="34" FontSize="18" FontWeight="Bold" Background="#3A4030" Command="{Binding IncreaseStatCommand}" CommandParameter="STR"/>
                                </Grid>
                            </Border>

                            <!-- Строка: ЛОВКОСТЬ -->
                            <Border Background="#221E28" BorderBrush="#3D3548" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="🎯 Ловкость" FontSize="15" FontWeight="Bold" Foreground="#66CC88"/>
                                        <TextBlock Text="+1.5% крит и уворот" FontSize="10" Foreground="#888"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="-" Height="34" FontSize="18" FontWeight="Bold" Background="#332A38" Command="{Binding DecreaseStatCommand}" CommandParameter="DEX"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Dexterity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                    <Button Grid.Column="3" Content="+" Height="34" FontSize="18" FontWeight="Bold" Background="#3A4030" Command="{Binding IncreaseStatCommand}" CommandParameter="DEX"/>
                                </Grid>
                            </Border>

                            <!-- Строка: ИНТЕЛЛЕКТ -->
                            <Border Background="#221E28" BorderBrush="#3D3548" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📖 Интеллект" FontSize="15" FontWeight="Bold" Foreground="#6699FF"/>
                                        <TextBlock Text="+6 мана, +2 маг. урон" FontSize="10" Foreground="#888"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="-" Height="34" FontSize="18" FontWeight="Bold" Background="#332A38" Command="{Binding DecreaseStatCommand}" CommandParameter="INT"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Intelligence}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                    <Button Grid.Column="3" Content="+" Height="34" FontSize="18" FontWeight="Bold" Background="#3A4030" Command="{Binding IncreaseStatCommand}" CommandParameter="INT"/>
                                </Grid>
                            </Border>

                            <!-- Строка: ВЫНОСЛИВОСТЬ -->
                            <Border Background="#221E28" BorderBrush="#3D3548" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="❤️ Выносливость" FontSize="15" FontWeight="Bold" Foreground="#FF6677"/>
                                        <TextBlock Text="+10 здоровье за очко" FontSize="10" Foreground="#888"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="-" Height="34" FontSize="18" FontWeight="Bold" Background="#332A38" Command="{Binding DecreaseStatCommand}" CommandParameter="END"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Endurance}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                    <Button Grid.Column="3" Content="+" Height="34" FontSize="18" FontWeight="Bold" Background="#3A4030" Command="{Binding IncreaseStatCommand}" CommandParameter="END"/>
                                </Grid>
                            </Border>

                            <!-- Производные характеристики (боевой профиль) -->
                            <Border Background="#1C1822" BorderBrush="#3E344A" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="📊 Боевой потенциал:" FontSize="13" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,6"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding HP, StringFormat='❤️ HP: {0}'}" FontSize="13" FontWeight="Bold" Foreground="#FF8888"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MP, StringFormat='🔷 MP: {0}'}" FontSize="13" FontWeight="Bold" Foreground="#77AAFF"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Damage, StringFormat='⚔️ Физ. урон: {0}'}" FontSize="12" Foreground="#DDAA88"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MagicDamage, StringFormat='🔮 Маг. урон: {0}'}" FontSize="12" Foreground="#CC88FF"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DodgeChance, StringFormat='💨 Уворот: {0:F1}%'}" FontSize="12" Foreground="#88CCAA"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CritChance, StringFormat='💥 Крит: {0:F1}%'}" FontSize="12" Foreground="#FFCC66"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Нижняя панель действий -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="⬅️ Назад в Главное Меню" Height="46" Width="260" FontSize="15" FontWeight="Bold"
                            HorizontalAlignment="Left" Background="#2E2836" BorderBrush="#554466" BorderThickness="1.5" Command="{Binding BackCommand}"/>

                    <Button Grid.Column="1" Content="⚔️ НАЧАТЬ ПОХОД ⚔️" Height="46" Width="280" FontSize="16" FontWeight="Bold"
                            HorizontalAlignment="Right" Background="#26642A" BorderBrush="#55AA55" BorderThickness="2" Command="{Binding StartGameCommand}"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
