<UserControl x:Class="EpicBattle.Views.CharacterCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EpicBattle.ViewModels"
             Background="#100E0D"
             Foreground="White">
    <UserControl.Resources>
        <local:ClassToColorConverter x:Key="ClassToColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <!-- Фоновое изображение -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
        <Border Background="#35100E14"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="СОЗДАНИЕ ПЕРСОНАЖА" FontSize="28" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: Класс и Имя -->
                    <Border Grid.Column="0" Background="#DD1A1820" BorderBrush="#554433" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Имя Героя:" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="6" Margin="0,0,0,15" Background="#26242E" Foreground="White" BorderBrush="#555"/>

                            <TextBlock Text="Выберите класс:" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Ветеран" Command="{Binding SelectClassCommand}" CommandParameter="Ветеран" Margin="0,0,8,0" Padding="10,5" Background="{Binding SelectedClass, Converter={StaticResource ResourceKey=ClassToColorConverter}, ConverterParameter=Ветеран}"/>
                                <Button Content="Изгой-маг" Command="{Binding SelectClassCommand}" CommandParameter="Изгой-маг" Margin="0,0,8,0" Padding="10,5" Background="{Binding SelectedClass, Converter={StaticResource ResourceKey=ClassToColorConverter}, ConverterParameter=Изгой-маг}"/>
                                <Button Content="Наемник" Command="{Binding SelectClassCommand}" CommandParameter="Наемник" Padding="10,5" Background="{Binding SelectedClass, Converter={StaticResource ResourceKey=ClassToColorConverter}, ConverterParameter=Наемник}"/>
                            </StackPanel>

                            <TextBlock Text="Описание класса:" FontSize="15" FontWeight="Bold" Margin="0,5,0,4"/>
                            <TextBlock Text="{Binding ClassDescription}" TextWrapping="Wrap" FontSize="13" Foreground="#CCC" Margin="0,0,0,15"/>

                            <TextBlock Text="Производные характеристики:" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HP, StringFormat='Здоровье: {0}'}" FontSize="13" Margin="0,2"/>
                            <TextBlock Text="{Binding MP, StringFormat='Мана: {0}'}" FontSize="13" Margin="0,2"/>
                            <TextBlock Text="{Binding Damage, StringFormat='Базовый урон: {0}'}" FontSize="13" Margin="0,2"/>
                            <TextBlock Text="{Binding MagicDamage, StringFormat='Магический урон: {0}'}" FontSize="13" Margin="0,2"/>
                            <TextBlock Text="{Binding DodgeChance, StringFormat='Шанс уклонения: {0}%'}" FontSize="13" Margin="0,2"/>
                            <TextBlock Text="{Binding CritChance, StringFormat='Шанс крит. удара: {0}%'}" FontSize="13" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Правая колонка: Статы -->
                    <Border Grid.Column="2" Background="#DD1A1820" BorderBrush="#554433" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Распределение очков:" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding AvailablePoints, StringFormat='Доступно очков: {0}'}" FontSize="16" Foreground="#FFAA00" Margin="0,0,0,20"/>

                            <!-- Strength -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сила:" VerticalAlignment="Center" FontSize="16"/>
                                <Button Grid.Column="1" Content="-" Width="30" Command="{Binding DecreaseStatCommand}" CommandParameter="STR"/>
                                <TextBlock Grid.Column="2" Text="{Binding Strength}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                <Button Grid.Column="3" Content="+" Width="30" Command="{Binding IncreaseStatCommand}" CommandParameter="STR"/>
                            </Grid>

                            <!-- Dexterity -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ловкость:" VerticalAlignment="Center" FontSize="16"/>
                                <Button Grid.Column="1" Content="-" Width="30" Command="{Binding DecreaseStatCommand}" CommandParameter="DEX"/>
                                <TextBlock Grid.Column="2" Text="{Binding Dexterity}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                <Button Grid.Column="3" Content="+" Width="30" Command="{Binding IncreaseStatCommand}" CommandParameter="DEX"/>
                            </Grid>

                            <!-- Intelligence -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Интеллект:" VerticalAlignment="Center" FontSize="16"/>
                                <Button Grid.Column="1" Content="-" Width="30" Command="{Binding DecreaseStatCommand}" CommandParameter="INT"/>
                                <TextBlock Grid.Column="2" Text="{Binding Intelligence}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                <Button Grid.Column="3" Content="+" Width="30" Command="{Binding IncreaseStatCommand}" CommandParameter="INT"/>
                            </Grid>

                            <!-- Endurance -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Выносливость:" VerticalAlignment="Center" FontSize="16"/>
                                <Button Grid.Column="1" Content="-" Width="30" Command="{Binding DecreaseStatCommand}" CommandParameter="END"/>
                                <TextBlock Grid.Column="2" Text="{Binding Endurance}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                <Button Grid.Column="3" Content="+" Width="30" Command="{Binding IncreaseStatCommand}" CommandParameter="END"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Назад" Command="{Binding BackCommand}" Width="150" Height="40" FontSize="16" Margin="0,0,20,0"/>
                    <Button Content="Начать Игру" Command="{Binding StartGameCommand}" Width="150" Height="40" FontSize="16" Background="#28a745" Foreground="White"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
