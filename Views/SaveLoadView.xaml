<UserControl x:Class="EpicBattle.Views.SaveLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0D10" Foreground="#E2D7C5">

    <UserControl.Resources>
        <!-- Базовый фэнтезийный стиль кнопки меню -->
        <Style x:Key="RpgMenuButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#282420" Offset="0.0"/>
                        <GradientStop Color="#191715" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E2D7C5"/>
            <Setter Property="BorderBrush" Value="#4A3F33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#D4A359"/>
                                <Setter Property="Foreground" Value="#FFF8EC"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#383129" Offset="0.0"/>
                                            <GradientStop Color="#221D18" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#B8863A"/>
                                <Setter TargetName="border" Property="Background" Value="#13110F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Акцентная первичная кнопка -->
        <Style x:Key="RpgPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RpgMenuButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3A2E1A" Offset="0.0"/>
                        <GradientStop Color="#20170A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#C99738"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#FFD97D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#FFAA00" Opacity="0.25" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFD566"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4C3A1F" Offset="0.0"/>
                                            <GradientStop Color="#2C1F0E" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" Color="#FFBB22" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AA771E"/>
                                <Setter TargetName="border" Property="Background" Value="#171107"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вторичная кнопка (Назад) -->
        <Style x:Key="RpgSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RpgMenuButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#221F1E" Offset="0.0"/>
                        <GradientStop Color="#151313" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38302A"/>
            <Setter Property="Foreground" Value="#AFA599"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль элемента списка сохранений -->
        <Style x:Key="SaveListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#1C1917"
                                BorderBrush="#3D352B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Cursor="Hand"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D4A359"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29231D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFAA00"/>
                                <Setter TargetName="ItemBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#382B1C" Offset="0.0"/>
                                            <GradientStop Color="#241B12" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.90"/>
        <Border Background="#350E0D10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <!-- Центральная каменная плита сохранений -->
                <Border Background="#E5141317" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="14" Width="470" Padding="26">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.85"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Заголовок -->
                        <Border BorderBrush="#3D3225" BorderThickness="0,0,0,1" Margin="0,0,0,16" Padding="0,0,0,10">
                            <TextBlock Name="TitleText" Text="— СОХРАНЕНИЯ —" Foreground="#FFAA00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Панель ввода названия нового сохранения (если режим сохранения) -->
                        <StackPanel Name="SaveInputPanel" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBox Name="SaveNameInput" Width="290" Height="36" FontSize="14" Margin="0,0,10,0"
                                     Background="#161412" Foreground="White" BorderBrush="#4A3F33" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="10,0">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Style="{StaticResource RpgPrimaryButtonStyle}" Content="💾 Сохранить" Width="116" Height="36" Click="CreateSaveBtn_Click"/>
                        </StackPanel>

                        <!-- Список файлов сохранений -->
                        <Border Background="#13110F" BorderBrush="#3D3225" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                            <ListBox Name="SavesList" Height="250" Background="Transparent" Foreground="White" FontSize="14"
                                     BorderThickness="0" ItemContainerStyle="{StaticResource SaveListItemContainerStyle}"
                                     SelectionChanged="SavesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFF0D2" FontSize="13.5"/>
                                            <TextBlock Text="{Binding LastWriteTime}" FontSize="11" Foreground="#958A7A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Панель кнопок действий -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Name="ActionBtn" Grid.Column="0" Style="{StaticResource RpgPrimaryButtonStyle}" Click="ActionBtn_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Загрузить" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource RpgMenuButtonStyle}" Click="DeleteBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Разделитель перед выходом -->
                        <Rectangle Height="1" Fill="#332B22" Margin="30,4,30,10"/>

                        <!-- Кнопка назад -->
                        <Button Style="{StaticResource RpgSecondaryButtonStyle}" Click="BackBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Назад в меню" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
