<UserControl x:Class="EpicBattle.Views.SaveLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a1a">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
            <TextBlock Name="TitleText" Text="СОХРАНЕНИЯ" Foreground="#FFAA00" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Name="SaveInputPanel" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBox Name="SaveNameInput" Width="300" Height="30" FontSize="16" Margin="0,0,10,0"/>
                <Button Content="Сохранить" Width="100" Click="CreateSaveBtn_Click"/>
            </StackPanel>

            <ListBox Name="SavesList" Height="300" Background="#333333" Foreground="White" FontSize="16" SelectionChanged="SavesList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LastWriteTime}" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Name="ActionBtn" Content="Загрузить" Width="120" Height="40" Margin="10" Click="ActionBtn_Click" IsEnabled="False"/>
                <Button Content="Удалить" Width="120" Height="40" Margin="10" Click="DeleteBtn_Click"/>
                <Button Content="Назад" Width="120" Height="40" Margin="10" Click="BackBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>