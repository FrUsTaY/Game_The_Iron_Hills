<UserControl x:Class="EpicBattle.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНИЙ ХАД (ИНФОРМАЦИЯ О ГЕРОЕ И КНОПКИ МЕНЮ) -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,2" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Инфо о Герое и Прогрессе -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2A2A2A" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,15,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PlayerName}" FontWeight="Bold" FontSize="15" Foreground="#FFAA00"/>
                                <TextBlock Text="{Binding PlayerClass, StringFormat=' ({0})'}" FontSize="13" Foreground="LightGray"/>
                                <TextBlock Text="{Binding PlayerLevel, StringFormat=' | Ур. {0}'}" FontSize="13" FontWeight="Bold" Foreground="#55FF55" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#88AAFF" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- HP и MP Бары -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0" Width="160">
                        <Grid Margin="0,0,0,4">
                            <ProgressBar Value="{Binding PlayerHp, Mode=OneWay}" Maximum="{Binding PlayerMaxHp, Mode=OneWay}" Height="16" Foreground="#D32F2F" Background="#441111"/>
                            <TextBlock Text="{Binding PlayerHp, StringFormat='❤️ {0}'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Grid>
                        <Grid>
                            <ProgressBar Value="{Binding PlayerMp, Mode=OneWay}" Maximum="{Binding PlayerMaxMp, Mode=OneWay}" Height="16" Foreground="#1976D2" Background="#112244"/>
                            <TextBlock Text="{Binding PlayerMp, StringFormat='💧 {0}'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <!-- Золото, Зелья и Очки -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2A2415" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Gold, StringFormat='💰 {0}'}" Foreground="#FFCC00" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        <Border Background="#1E3A24" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding HpPotions, StringFormat='🧪 {0}'}" Foreground="#55FF55" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <Border Background="#1E2E4A" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding MpPotions, StringFormat='💧 {0}'}" Foreground="#55AAFF" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <Border Background="#2A2230" BorderBrush="#8D6E63" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding OreStock, StringFormat='⛏️ {0}'}" Foreground="#DDAA88" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <Border Background="#222A35" BorderBrush="#5C85B0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding RuneStockCount, StringFormat='🪨 {0}'}" Foreground="#7EC8E3" FontWeight="Bold" FontSize="13"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопки управления и перехода -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🎒 Инвентарь" Padding="12,7" FontSize="13" Background="#2E3A4A" Margin="0,0,8,0" Click="OpenInventory_Click"/>
                    <Button Content="🌳 Навыки" Padding="12,7" FontSize="13" Background="#3A2E4A" Margin="0,0,8,0" Click="OpenSkillTree_Click"/>
                    <Button Content="💾 Сохранить" Padding="12,7" FontSize="13" Background="#2E4A3A" Margin="0,0,8,0" Click="SaveGame_Click"/>
                    <Button Content="🚪 Меню" Padding="12,7" FontSize="13" Background="#442222" Click="MainMenu_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ЦЕНТРАЛЬНАЯ КАРТА МИРА (ИНТЕРАКТИВНАЯ ЛЕСТНИЦА ЭТАЖЕЙ) -->
        <ScrollViewer Grid.Row="1" x:Name="MapScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#101010">
            <StackPanel HorizontalAlignment="Center" Width="860" Margin="0,25">

                <!-- Инструкция -->
                <Border Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                    <TextBlock Text="🗺️ Выберите доступный узел (подсвечен золотой рамкой) для продвижения вперед по Железному Кряжу:"
                               FontSize="13" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                </Border>

                <!-- Этажи карты -->
                <ItemsControl ItemsSource="{Binding FloorGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Название этажа -->
                                    <Border Grid.Row="0" Background="#222222" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding FloorTitle}" FontSize="13" FontWeight="Bold" Foreground="#FFAA00"/>
                                    </Border>

                                    <!-- Узлы этажа -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Nodes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CardBackground}" 
                                                        BorderBrush="{Binding StatusColor}" 
                                                        BorderThickness="2" 
                                                        CornerRadius="8" 
                                                        Padding="10" 
                                                        Margin="6" 
                                                        Opacity="{Binding NodeOpacity}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Бейдж типа узла -->
                                                        <Border Grid.Row="0" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding NodeTypeName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Заголовок узла -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                                        <!-- Описание узла -->
                                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11" Foreground="LightGray" Margin="0,0,0,8" TextWrapping="Wrap" MinHeight="34"/>

                                                        <!-- Кнопка действия -->
                                                        <Button Grid.Row="3" Height="36" FontSize="13" FontWeight="Bold"
                                                                Content="{Binding ActionButtonText}"
                                                                Background="{Binding ActionButtonBackground}"
                                                                Foreground="{Binding ActionButtonForeground}"
                                                                IsEnabled="{Binding IsClickable}"
                                                                Tag="{Binding}"
                                                                Click="NodeBtn_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ОВЕРЛЕЙ ТРИУМФА / ПОБЕДЫ В АКТЕ -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#DD000000" Panel.ZIndex="100"
                Visibility="{Binding VictoryOverlayVisibility}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1E1E1E" BorderBrush="#FFAA00" BorderThickness="2" CornerRadius="10" Padding="30" Width="600">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏆 ПОБЕДА НАД БОССОМ ГЛАВЫ!" Foreground="#FFAA00" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding VictoryDescriptionText}" Foreground="LightGray" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="0,0,0,20"/>

                    <Border Background="#282828" CornerRadius="6" Padding="15" Margin="0,0,0,25">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎁 НАГРАДЫ ЗА ОСВОБОЖДЕНИЕ КРЯЖА:" Foreground="#55FF55" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="💰 Золото: +150 | ✨ Очки характеристик: +2 | 🌳 Очки навыков: +1" Foreground="White" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding NextActButtonText}" Height="45" Padding="20,0" FontSize="15" FontWeight="Bold" Background="#2E6B30" Margin="0,0,15,0" Click="NextActBtn_Click"/>
                        <Button Content="🚪 Главное меню" Height="45" Padding="20,0" FontSize="15" Background="#442222" Click="MainMenu_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
