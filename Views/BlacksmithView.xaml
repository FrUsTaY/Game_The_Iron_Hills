<UserControl x:Class="EpicBattle.Views.BlacksmithView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141008" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ: ЗАГОЛОВОК КУЗНЕЦА И РЕСУРСЫ -->
        <Border Grid.Row="0" Background="#241A0C" BorderBrush="#B8860B" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔨" FontSize="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="КУЗНИЦА КРЯЖА" FontSize="20" FontWeight="Bold" Foreground="#FFAA00"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2D2410" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰 Золото: " Foreground="#FFCC00" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding PlayerGold}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2A2A35" BorderBrush="#8D6E63" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding OreStock, StringFormat='⛏️ Руда: {0}'}" Foreground="#DDAA88" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <Border Background="#1E2E4A" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding UpgradeCount, StringFormat='⭐ Ковок: {0}'}" Foreground="#55AAFF" FontWeight="Bold" FontSize="14"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ: НАКОВальня (список предметов) и услуги кузнеца -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: ПРЕДМЕТЫ ДЛЯ УЛУЧШЕНИЯ -->
            <Border Grid.Column="0" Background="#1A1510" BorderBrush="#3A2E1E" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="⚒️ Снаряжение для улучшения (+25% свойств за ковку):" FontSize="16" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ForgeableItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#241E14" BorderBrush="{Binding RarityColor}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Icon}" FontSize="24"/>
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{Binding RarityColor}"/>
                                                <TextBlock Text="{Binding SlotName}" FontSize="11" Foreground="Gray"/>
                                                <TextBlock Text="{Binding CurrentStats}" FontSize="12" Foreground="#55FF55" FontWeight="Bold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding PreviewText}" FontSize="11" Foreground="#FFCC88" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="🔨 Улучшить" Padding="14,8" FontSize="13" FontWeight="Bold" Background="#8D4E1A"
                                                        Tag="{Binding}" Click="UpgradeItem_Click" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CostText}" FontSize="12" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ПРАВАЯ КОЛОНКА: УСЛУГИ КУЗНЕЦА -->
            <Border Grid.Column="1" Background="#1A1510" BorderBrush="#3A2E1E" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="📜 Услуги мастера:" FontSize="16" FontWeight="Bold" Foreground="#DDAA88" Margin="0,0,0,12"/>

                    <Button Padding="12,10" Margin="0,0,0,8" Background="#4A3728" Click="BuyOre_Click">
                        <StackPanel>
                            <TextBlock Text="⛏️ Купить Железную Руду (💰 30)" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Материал, необходимый для каждой ковки." Foreground="Gray" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button Padding="12,10" Margin="0,0,0,8" Background="#3A2E5A" Click="Sharpen_Click">
                        <StackPanel>
                            <TextBlock Text="⚔️ Заточить оружие (💰 40)" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="+1 к базовому урону и магическому урону навсегда." Foreground="Gray" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button Padding="12,10" Margin="0,0,0,8" Background="#5A2E3A" Click="Reforge_Click">
                        <StackPanel>
                            <TextBlock Text="⚗️ Перековка характеристик (💰 80, цена ×2 за каждую подряд!)" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Риск-дело: −1 к одной характеристике, +1 к другой (случайно)." Foreground="Gray" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#221C12" BorderBrush="#554422" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ReforgePreview}" FontSize="12" Foreground="#FFCC88" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- НИЖНЯЯ ПАНЕЛЬ: ВЫХОД ИЗ КУЗНИЦЫ -->
        <Button Grid.Row="2" Content="🗺️ Покинуть кузницу и продолжить путь" Height="45" Width="340" FontSize="15" FontWeight="Bold"
                Background="#443366" HorizontalAlignment="Center" Margin="0,15,0,0" Click="LeaveSmith_Click"/>
    </Grid>
</UserControl>
