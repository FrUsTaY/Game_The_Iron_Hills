<UserControl x:Class="EpicBattle.Views.TavernView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#171210" Foreground="White"
             xmlns:vm="clr-namespace:EpicBattle.ViewModels">
    <UserControl.Resources>
        <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
    </UserControl.Resources>
    <Grid>
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45"/>
        <Border Background="#C0171210"/>
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0" Background="#2A1E14" BorderBrush="#8D6E63" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍺" FontSize="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ТАВЕРНА КРЯЖА" FontSize="20" FontWeight="Bold" Foreground="#DDAA88"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2D2410" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock Text="{Binding PlayerGold, StringFormat='💰 {0}'}" Foreground="#FFCC00" FontWeight="Bold" FontSize="15"/>
                    </Border>
                    <Border Background="#351E1E" BorderBrush="#C05050" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock Foreground="#FF8888" FontWeight="Bold" FontSize="14">
                            <Run Text="❤️ "/><Run Text="{Binding PlayerHp, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding PlayerMaxHp, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#1E2E4A" BorderBrush="#5599DD" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <TextBlock Foreground="#77BBFF" FontWeight="Bold" FontSize="14">
                            <Run Text="🔷 "/><Run Text="{Binding PlayerMp, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding PlayerMaxMp, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ЦЕНТР: УСЛУГИ И СКЛАД РУН -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="📜 Услуги трактирщика:" FontSize="16" FontWeight="Bold" Foreground="#DDAA88" Margin="0,0,0,10"/>

                <Button Padding="12,10" Margin="0,0,0,8" Background="#4A3728" Click="Rest_Click"
                        IsEnabled="{Binding CanRest}">
                    <StackPanel>
                        <TextBlock Text="{Binding RestButtonLabel}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="+45% HP и +60% MP. Цена растёт при частых визитах." Foreground="Gray" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Button Padding="12,10" Margin="0,0,0,8" Background="#3A2E5A" Click="Rumor_Click"
                        IsEnabled="{Binding CanHearRumor}">
                    <StackPanel>
                        <TextBlock Text="🗣️ Кружка эля и слух (💰 15)" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Трактирщик шепнёт кое-что полезное. Или нет." Foreground="Gray" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <Border Background="#221C12" BorderBrush="#554422" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                    <TextBlock Text="{Binding RumorText}" FontSize="12" Foreground="#FFCC88" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="#1A1510" BorderBrush="#3A2E1E" BorderThickness="1" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="💠 Скупка рунических камней (70% от цены):" FontSize="16" FontWeight="Bold" Foreground="#88CCEE" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RuneSaleList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#241E14" BorderBrush="#446688" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Foreground="#BBDDFF" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="Продать" Padding="12,6" FontSize="12" FontWeight="Bold" Background="#2E5A4A"
                                                    Tag="{Binding}" Click="SellRune_Click" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SellPriceEach, StringFormat='+{0} 💰'}" FontSize="11" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,26,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="Склад пуст. Руны выпадают с элитных боёв и боссов." FontSize="13" Foreground="Gray"
                               Visibility="{Binding HasRunesToSell, Converter={StaticResource InverseBoolVis}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- НИЗ: ВЫХОД -->
        <Button Grid.Row="2" Content="🗺️ Покинуть таверну и продолжить путь" Height="45" Width="340" FontSize="15" FontWeight="Bold"
                Background="#443366" HorizontalAlignment="Center" Margin="0,15,0,0" Click="LeaveTavern_Click"/>
        </Grid>
    </Grid>
</UserControl>
