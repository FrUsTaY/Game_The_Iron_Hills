<UserControl x:Class="EpicBattle.Views.IntroVideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000"
             Focusable="True">
    <Grid Background="#000000" Cursor="Hand" MouseDown="Grid_MouseDown" MouseMove="Grid_MouseMove">
        <!-- Видеоплеер -->
        <MediaElement x:Name="VideoPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Close"
                      Stretch="Uniform"
                      ScrubbingEnabled="True"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MediaOpened="VideoPlayer_MediaOpened"
                      MediaEnded="VideoPlayer_MediaEnded"
                      MediaFailed="VideoPlayer_MediaFailed"/>

        <!-- Подсказка / Панель пропуска видео -->
        <Border x:Name="SkipPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="#B0101015"
                BorderBrush="#665544"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8"
                Opacity="0.75">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SkipHintText"
                           Text="⏭️ Пробел / Клик — далее  •  Esc — в меню"
                           Foreground="#D0C8B8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button Content="Пропустить"
                        Background="#352520"
                        Foreground="#FFAA00"
                        BorderBrush="#8A6B48"
                        BorderThickness="1"
                        Padding="10,3"
                        FontSize="11"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="SkipButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Затемнение для плавных кинематографических переходов -->
        <Border x:Name="FadeOverlay"
                Background="#000000"
                Opacity="1"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
