<UserControl x:Class="EpicBattle.Views.BestiaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0D10" Foreground="#E2D7C5">

    <UserControl.Resources>
        <!-- Вторичная кнопка (Назад) -->
        <Style x:Key="RpgSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#221F1E" Offset="0.0"/>
                        <GradientStop Color="#151313" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38302A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#AFA599"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#D4A359"/>
                                <Setter Property="Foreground" Value="#FFF8EC"/>
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#383129" Offset="0.0"/>
                                            <GradientStop Color="#221D18" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#B8863A"/>
                                <Setter TargetName="border" Property="Background" Value="#13110F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль элемента списка существ -->
        <Style x:Key="BestiaryListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#1C1917"
                                BorderBrush="#383025"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Cursor="Hand"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D4A359"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A241D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFAA00"/>
                                <Setter TargetName="ItemBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#382B1C" Offset="0.0"/>
                                            <GradientStop Color="#241B12" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Фоновое изображение -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45"/>
        <Border Background="#E60D0B12"/>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: Назад + Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Button Style="{StaticResource RpgSecondaryButtonStyle}" Click="BackBtn_Click" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="В главное меню" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="— БЕСТИАРИЙ И ХРОНИКИ КРЯЖА —" FontSize="20" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center"/>
                    <TextBlock Text="Свод знаний о монстрах, порождениях тьмы, древних колоссах и героях" FontSize="12" Foreground="#958A7A" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Фильтры категорий -->
            <Border Grid.Row="1" Background="#80141210" BorderBrush="#4A3F33" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,14">
                <WrapPanel Name="CategoryFiltersPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Главная панель: Список слева + Детали справа -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Список существ (360px) -->
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <!-- Детальное досье (*) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Список -->
                <Border Grid.Column="0" Background="#E5141317" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="12" Padding="12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.8"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск по названию -->
                        <Border Grid.Row="0" Background="#141210" BorderBrush="#3D352B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <Grid>
                                <TextBox Name="SearchBox" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
                                <TextBlock Name="SearchPlaceholder" Text="🔍 Поиск по названию..." Foreground="#7E7364" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Список существ -->
                        <ListBox Grid.Row="1" Name="EntriesListBox" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource BestiaryListItemContainerStyle}"
                                 SelectionChanged="EntriesListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Миниатюра -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="5" ClipToBounds="True" Background="#0F0E0C" BorderBrush="#4A3F33" BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Текст -->
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="#FFF0D2" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#958A7A" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Правая колонка: Досье выбранного существа в стиле Ведьмака -->
                <Border Grid.Column="2" Background="#E5141317" BorderBrush="#554433" BorderThickness="1.5" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.8"/>
                    </Border.Effect>
                    <Grid Name="DetailsGrid">
                        <Grid.ColumnDefinitions>
                            <!-- Колонка арта: 340px -->
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="20"/>
                            <!-- Текстовое досье -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Крупный арт -->
                        <Border Grid.Column="0" CornerRadius="8" BorderBrush="#C89B3C" BorderThickness="1.5" ClipToBounds="True" Background="#0C0B0A" VerticalAlignment="Stretch">
                            <Grid>
                                <Image Name="DetailArtImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border VerticalAlignment="Bottom" Height="90">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC0A0810" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Скроллируемое описание -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Name="DetailTitleText" Foreground="#FFF5E5" FontSize="24" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Name="DetailSubtitleText" Foreground="#D4A359" FontSize="13" FontStyle="Italic" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Background="#2A2218" BorderBrush="#5A4732" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Name="DetailCategoryBadge" Foreground="#E5C07B" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#2E1818" BorderBrush="#602828" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                        <TextBlock Name="DetailDangerBadge" Foreground="#E57373" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Эпиграф -->
                                <Border Background="#1A1816" BorderBrush="#3D352B" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Border BorderBrush="#C89B3C" BorderThickness="3,0,0,0" Margin="-14,-12,0,-12"/>
                                        <TextBlock Name="DetailEpigraphText" Foreground="#D0C4B0" FontSize="12.5" FontStyle="Italic" TextWrapping="Wrap" LineHeight="19" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Лор -->
                                <TextBlock Text="ЛОР И ПРОИСХОЖДЕНИЕ" Foreground="#FFAA00" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Name="DetailDescriptionText" Foreground="#DDD4C5" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18"/>

                                <!-- Тактика -->
                                <TextBlock Text="ТАКТИЧЕСКИЕ ЗАМЕТКИ" Foreground="#D4A359" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Border Background="#191715" BorderBrush="#3D352B" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <TextBlock Name="DetailTacticsText" Foreground="#DDD4C5" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
