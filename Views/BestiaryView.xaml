<UserControl x:Class="EpicBattle.Views.BestiaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0D10" Foreground="White">
    <Grid>
        <!-- Фоновое изображение -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45"/>
        <Border Background="#E60D0B12"/>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: Назад + Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Button Click="BackBtn_Click" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Padding="16,8" Height="38" Background="#261E2E" BorderBrush="#554466">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅ В главное меню" FontSize="13" FontWeight="SemiBold" Foreground="#FFAA00"/>
                    </StackPanel>
                </Button>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📖 БЕСТИАРИЙ И ХРОНИКИ КРЯЖА" FontSize="24" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center"/>
                    <TextBlock Text="Свод знаний о монстрах, порождениях тьмы, древних колоссах и героях" FontSize="12.5" Foreground="#999999" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Фильтры категорий -->
            <Border Grid.Row="1" Background="#60181422" BorderBrush="#4A3D5A" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,14">
                <WrapPanel Name="CategoryFiltersPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Главная панель: Список слева + Детали справа -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Список существ (360px) -->
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <!-- Детальное досье (*) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Список -->
                <Border Grid.Column="0" Background="#DD131118" BorderBrush="#5A4736" BorderThickness="1.5" CornerRadius="10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Поиск по названию -->
                        <Border Grid.Row="0" Background="#1D1A24" BorderBrush="#3D354A" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <Grid>
                                <TextBox Name="SearchBox" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
                                <TextBlock Name="SearchPlaceholder" Text="🔍 Поиск по названию..." Foreground="#666666" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Список существ -->
                        <ListBox Grid.Row="1" Name="EntriesListBox" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="EntriesListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="8,6" Background="#201C28" BorderBrush="#3D354A" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Миниатюра -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="5" ClipToBounds="True" Background="#110E17" BorderBrush="#8A6B48" BorderThickness="1">
                                                <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- Текст -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Правая колонка: Досье выбранного существа в стиле Ведьмака -->
                <Border Grid.Column="2" Background="#DD14111B" BorderBrush="#8A6B48" BorderThickness="1.5" CornerRadius="10" Padding="20">
                    <Grid Name="DetailsGrid">
                        <Grid.ColumnDefinitions>
                            <!-- Колонка арта: 340px -->
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="20"/>
                            <!-- Текстовое досье -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Крупный арт -->
                        <Border Grid.Column="0" CornerRadius="10" BorderBrush="#C89B3C" BorderThickness="2" ClipToBounds="True" Background="#0C0A10" VerticalAlignment="Stretch">
                            <Grid>
                                <Image Name="DetailArtImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border VerticalAlignment="Bottom" Height="90">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC0A0810" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Скроллируемое описание -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Name="DetailTitleText" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Name="DetailSubtitleText" Foreground="#E0B669" FontSize="13.5" FontStyle="Italic" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Background="#2B1D38" BorderBrush="#6B4B8A" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Name="DetailCategoryBadge" Foreground="#CE93D8" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="#3E1A1A" BorderBrush="#8A3333" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                        <TextBlock Name="DetailDangerBadge" Foreground="#FF8A80" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Эпиграф -->
                                <Border Background="#1C1720" BorderBrush="#3D3246" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Border BorderBrush="#C89B3C" BorderThickness="3,0,0,0" Margin="-14,-12,0,-12"/>
                                        <TextBlock Name="DetailEpigraphText" Foreground="#D0C4B0" FontSize="12.5" FontStyle="Italic" TextWrapping="Wrap" LineHeight="19" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Лор -->
                                <TextBlock Text="ЛОР И ПРОИСХОЖДЕНИЕ" Foreground="#FFAA00" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Name="DetailDescriptionText" Foreground="#E0E0E0" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,18"/>

                                <!-- Тактика -->
                                <TextBlock Text="ТАКТИЧЕСКИЕ ЗАМЕТКИ" Foreground="#4DD0E1" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Border Background="#122329" BorderBrush="#1E4753" BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <TextBlock Name="DetailTacticsText" Foreground="#B2EBF2" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
