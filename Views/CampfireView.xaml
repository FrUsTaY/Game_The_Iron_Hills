<UserControl x:Class="EpicBattle.Views.CampfireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141210" Foreground="White">
    <Grid>
        <!-- Фоновое изображение -->
        <Image Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
        <Border Background="#35141212"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ШАПКА ПРИВАЛА -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="⛺ ПРИВАЛ У КОСТРА ⛺" FontSize="26" FontWeight="Bold" Foreground="#FFAA33" HorizontalAlignment="Center"/>
                    <TextBlock Text="Среди холодных скал Железного Кряжа вы разбили лагерь. Пламя костра восстанавливает силы."
                               FontSize="13" Foreground="#CCAA88" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- ПАНЕЛЬ ТЕКУЩЕГО СОСТОЯНИЯ ГЕРОЯ -->
                <Border Grid.Row="1" Background="#DD1F1A15" BorderBrush="#774422" BorderThickness="1" CornerRadius="8" Padding="15" Width="720" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="❤️ Здоровье" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Name="HpText" Text="100 / 100" Foreground="#55FF55" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="💧 Мана" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Name="MpText" Text="50 / 50" Foreground="#55AAFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="🧪 Зелья" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Name="PotionsText" Text="3 HP / 2 MP" Foreground="#FFCC55" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="✨ Свободные Очки" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Name="PointsText" Text="0 Статов / 0 Навыков" Foreground="#CC88FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ВАРИАНТЫ ДЕЙСТВИЙ НА ПРИВАЛЕ -->
                <StackPanel Grid.Row="2" Width="720" HorizontalAlignment="Center">
                    <TextBlock Text="Выберите одно действие на стоянке:" FontSize="15" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,0,10"/>

                    <!-- Вариант 1: Отдохнуть -->
                    <Border Background="#DD241E18" BorderBrush="#553822" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="🔥 Крепкий сон у огня" FontSize="16" FontWeight="Bold" Foreground="#FFAA33"/>
                                <TextBlock Text="Восстанавливает 40% максимального здоровья, 50% маны и пополняет 1 случайный заряд зелья." FontSize="12" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Name="RestBtn" Grid.Column="1" Content="Отдохнуть" Height="40" FontSize="14" FontWeight="Bold" Background="#774422" Click="RestBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Вариант 2: Медитировать -->
                    <Border Background="#DD241E18" BorderBrush="#553822" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="🧘 Руническая медитация" FontSize="16" FontWeight="Bold" Foreground="#88AAFF"/>
                                <TextBlock Text="Очистить разум и постичь древние тайны гор. Дает +1 Очко Характеристик и +1 Очко Навыков." FontSize="12" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Name="MeditateBtn" Grid.Column="1" Content="Медитировать" Height="40" FontSize="14" FontWeight="Bold" Background="#334466" Click="MeditateBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Вариант 3: Заточить снаряжение -->
                    <Border Background="#DD241E18" BorderBrush="#553822" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="⚔️ Заточить клинки и снаряжение" FontSize="16" FontWeight="Bold" Foreground="#55FF55"/>
                                <TextBlock Text="Идеально подготовить оружие. Увеличивает базовый физический и магический урон на +1 навсегда. Требует 1 Железную Руду Кряжа (⛏️)." FontSize="12" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Name="SharpenBtn" Grid.Column="1" Content="Заточить (⛏️ 1)" Height="40" FontSize="14" FontWeight="Bold" Background="#2E6B30" Click="SharpenBtn_Click" ToolTip="+1 к базовому урону и магии навсегда. Требует 1 Железную Руду Кряжа."/>
                        </Grid>
                    </Border>

                    <!-- Инвентарь и Навыки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                        <Button Content="🎒 Открыть Инвентарь" Padding="15,8" FontSize="13" Background="#333333" Margin="0,0,15,0" Click="OpenInventory_Click"/>
                        <Button Content="🌳 Дерево Навыков" Padding="15,8" FontSize="13" Background="#333333" Click="OpenSkillTree_Click"/>
                    </StackPanel>

                    <!-- Текст результата -->
                    <TextBlock Name="ResultText" Text="" FontSize="14" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- КНОПКА ПРОДОЛЖИТЬ -->
                <Button Grid.Row="3" Content="🗺️ Собрать лагерь и продолжить путь" Height="45" Width="360" FontSize="15" FontWeight="Bold"
                        Background="#443366" HorizontalAlignment="Center" Margin="0,15,0,0" Click="ContinueBtn_Click"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
