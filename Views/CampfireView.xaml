<UserControl x:Class="EpicBattle.Views.CampfireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141210" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА ПРИВАЛА -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="⛺ ПРИВАЛ У КОСТРА ⛺" FontSize="26" FontWeight="Bold" Foreground="#FFAA33" HorizontalAlignment="Center"/>
                <TextBlock Text="Среди холодных скал Железного Кряжа вы разбили лагерь. Пламя костра восстанавливает силы."
                           FontSize="13" Foreground="#CCAA88" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <!-- ПАНЕЛЬ ТЕКУЩЕГО СОСТОЯНИЯ ГЕРОЯ -->
            <Border Grid.Row="1" Background="#1F1A15" BorderBrush="#774422" BorderThickness="1" CornerRadius="8" Padding="15" Width="720" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="❤️ Здоровье" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Name="HpText" Text="100 / 100" Foreground="#55FF55" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="💧 Мана" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Name="MpText" Text="50 / 50" Foreground="#55AAFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="🧪 Зелья" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Name="PotionsText" Text="3 HP / 2 MP" Foreground="#FFCC55" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="✨ Свободные Очки" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Name="PointsText" Text="0 Статов / 0 Навыков" Foreground="#CC88FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- КАРТОЧКИ ДЕЙСТВИЙ НА ПРИВАЛЕ -->
            <StackPanel Grid.Row="2" Width="720" HorizontalAlignment="Center">
                
                <!-- Действие 1: Отдых -->
                <Border Background="#241C16" BorderBrush="#884422" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🔥 Отдохнуть и согреться" FontSize="16" FontWeight="Bold" Foreground="#FFAA33"/>
                            <TextBlock Text="Восстанавливает 40% максимального здоровья и 50% маны. Добавляет 1 зелье HP при их отсутствии." FontSize="12" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Name="RestBtn" Grid.Column="1" Content="Отдохнуть" Height="40" FontSize="14" FontWeight="Bold" Background="#A04010" Click="RestBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Действие 2: Медитация -->
                <Border Background="#1C1624" BorderBrush="#663388" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="🧘 Медитировать и постичь опыт" FontSize="16" FontWeight="Bold" Foreground="#CC88FF"/>
                            <TextBlock Text="Очистить разум перед схваткой. Получить +1 Очко Характеристик и +1 Очко Навыков." FontSize="12" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Name="MeditateBtn" Grid.Column="1" Content="Медитировать" Height="40" FontSize="14" FontWeight="Bold" Background="#5A2E80" Click="MeditateBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Действие 3: Заточка оружия -->
                <Border Background="#1A2218" BorderBrush="#336633" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="⚔️ Заточить клинки и снаряжение" FontSize="16" FontWeight="Bold" Foreground="#55FF55"/>
                            <TextBlock Text="Идеально подготовить оружие. Увеличивает базовый физический и магический урон на +2 навсегда." FontSize="12" Foreground="LightGray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Name="SharpenBtn" Grid.Column="1" Content="Заточить" Height="40" FontSize="14" FontWeight="Bold" Background="#2E6B30" Click="SharpenBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Инвентарь и Навыки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                    <Button Content="🎒 Открыть Инвентарь" Padding="15,8" FontSize="13" Background="#333333" Margin="0,0,15,0" Click="OpenInventory_Click"/>
                    <Button Content="🌳 Дерево Навыков" Padding="15,8" FontSize="13" Background="#333333" Click="OpenSkillTree_Click"/>
                </StackPanel>

                <!-- Текст результата -->
                <TextBlock Name="ResultText" Text="" FontSize="14" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- КНОПКА ПРОДОЛЖИТЬ -->
            <Button Grid.Row="3" Content="🗺️ Собрать лагерь и продолжить путь" Height="45" Width="360" FontSize="15" FontWeight="Bold"
                    Background="#443366" HorizontalAlignment="Center" Margin="0,15,0,0" Click="ContinueBtn_Click"/>
        </Grid>
    </ScrollViewer>
</UserControl>
