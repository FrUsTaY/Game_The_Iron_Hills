<Window x:Class="EpicBattle.Views.RpgMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Весть"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">

    <!-- Тень и внешняя граница окна -->
    <Border Margin="12"
            Background="#F2141118"
            BorderBrush="#C89B3C"
            BorderThickness="2"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
        </Border.Effect>

        <!-- Внутренняя золотистая окантовка Dark RPG -->
        <Border BorderBrush="#35FFAA00" BorderThickness="1" CornerRadius="8" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Шапка (Иконка, Заголовок, Кнопка закрытия) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Разделитель -->
                    <RowDefinition Height="Auto"/>
                    <!-- Текст сообщения -->
                    <RowDefinition Height="*"/>
                    <!-- Кнопка действия -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="HeaderIcon" Grid.Column="0" Text="📜" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Name="TitleText" Grid.Column="1" Text="ВЕСТЬ ИЗ КРЯЖА" Foreground="#FFAA00" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="✕" Width="28" Height="28" FontSize="13" FontWeight="Bold"
                            Background="#302022" Foreground="#D5C5B5" BorderBrush="#5E3838" BorderThickness="1"
                            Click="CloseBtn_Click" Cursor="Hand" ToolTip="Закрыть (Esc)"/>
                </Grid>

                <!-- Золотистый градиентный разделитель -->
                <Border Grid.Row="1" Height="1.5" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFAA00" Offset="0.0"/>
                            <GradientStop Color="#80FFAA00" Offset="0.3"/>
                            <GradientStop Color="#80FFAA00" Offset="0.7"/>
                            <GradientStop Color="#00FFAA00" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Текст сообщения -->
                <ScrollViewer Grid.Row="2" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4,0,4,16">
                    <TextBlock Name="MessageText"
                               Text="Содержимое сообщения..."
                               Foreground="#ECE4D8"
                               FontSize="15"
                               LineHeight="23"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Нижняя кнопка подтверждения -->
                <Border Grid.Row="3" HorizontalAlignment="Center">
                    <Button Name="ConfirmBtn"
                            Content="⚔️ ПРИНЯТЬ"
                            Width="160"
                            Height="40"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#2E6B30"
                            BorderBrush="#55AA55"
                            BorderThickness="1.5"
                            Foreground="White"
                            Click="ConfirmBtn_Click"
                            Cursor="Hand"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
